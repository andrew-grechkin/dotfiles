#!/usr/bin/env -S bash -Eeuo pipefail

dir=$(dirname "$0")
name=$(basename "$0")
source "$dir/.common.bash"

[[ -d "$dir/$name.d" ]] || exit 0

current_message=$(< "$1")

for hook in "$dir/$name.d"/*; do
    [[ -x "$hook" ]] || continue
    generated_message=$("$hook" "$@") || continue
    {
        echo "$generated_message"
        echo
        perl -lpE 's/^/# / unless /^#/' <<< "$current_message"
    } > "$1"
    break
done

exit 0
