# vim: filetype=just

set export

# trim all leading and trailing whitespaces for the input as a whole and ensures new line in the end
[group('text'), private]
@trim-stream:
    exec perl -g -pE '$_ = builtin::trim($_); END{say}'

[group('common'), private, positional-arguments, no-exit-message]
@fatal message *argv:
    >&2 echo "{{style('error')}}${*}{{NORMAL}}"
    exit 1

[group('common'), private, positional-arguments]
@print message *argv:
    [[ -t 1 ]] && >&2 echo "{{style('warning')}}${*}{{NORMAL}}" || true

[group('common'), private, no-exit-message]
assert-encoding file:
    #!/usr/bin/env -S bash -Eeuo pipefail
    encoding=$(file -b --mime-encoding "$file")

    if [[ "$encoding" != "utf-8" && "$encoding" != "us-ascii" ]]; then
        "$this" fatal "unexpected file encoding [$encoding]: $file"
    fi
