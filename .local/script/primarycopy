#!/usr/bin/env bash

set -Eeuo pipefail

# primarycopy - Copy data to the PRIMARY buffer
#
# Usage:
#  <command> | primarycopy      - copies stdin to primary
#  primarycopy <file> <file>... - copies file's contents to primary

case "$OSTYPE" in
	cygwin* | msys*)
		cat "$@" >/dev/primary
		;;
	*)
		if [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v wl-copy >/dev/null; then
			# wl-copy's broken async behavior: it forks and returns before the compositor accepts the
			# selection, and the forked owner dies with the launching terminal (e.g. a keybinding-spawned
			# window). setsid -f moves the owner into its own session, otherwise the selection is lost.
			cat "$@" | setsid -f wl-copy --primary
		elif [[ -n "$(command -v xsel)" ]]; then
			cat "$@" | xsel --input --primary &>/dev/null
		elif [[ -n "$(command -v xclip)" ]]; then
			cat "$@" | xclip -sel p &>/dev/null
		else
			echo "primarycopy: no Wayland or X11 primary selection available (install wl-clipboard)" >&2
			exit 1
		fi
		;;
esac
