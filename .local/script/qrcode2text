#!/usr/bin/env -S bash -Eeuo pipefail

# NOTE: trim is there because zbarimg adds multiple new lines at the end by some reason
{
    if [[ -x "$(command -v spectacle)" ]]; then
        # NOTE: spectacle on Wayland saves atomically, so it cannot write to /dev/stdout
        tmp="$(mktemp --suffix=.png)"
        trap 'rm -f "$tmp"' EXIT
        spectacle -b -n -r -o "$tmp" >/dev/null 2>&1
        [[ -s "$tmp" ]] || exit 0
        cat "$tmp"
    else
        magick import -window root bmp:-
    fi
} | zbarimg --raw -Stest-inverted - 2>/dev/null | perl -gnE 'say trim($_) if $_' | clipcopy
