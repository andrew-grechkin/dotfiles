#!/usr/bin/env -S just --one --justfile

# https://just.systems/man/en/

mod fzf "~/.local/lib/just/fzf"
mod json "~/.local/lib/just/json"

set export
set no-cd

export colored-md := require('colored-md') # https://github.com/andrew-grechkin/colored-md
export this := justfile()
export tui := 'auto'

# => default ------------------------------------------------------------------------------------------------------ {{{1

# Run TUI if interactive, otherwise print static view
[private]
default:
    #!/usr/bin/env -S bash -Eeuo pipefail
    if [[ "$tui" == 'force' ]] || [[ "$tui" == 'auto' && -t 1 ]]; then
        exec "$this" controller
    fi
    exec "$this" view

# Print help
help:
    #!/usr/bin/env -S colored-md

    # ABSTRACT
    Interactive TUI for searching and managing pacman packages

    # DESCRIPTION
    `menu-pacman` provides a unified, interactive interface for the `pacman` package manager.

    It solves the problem of running multiple `pacman` commands to see what's available, what's installed, and
    whether a package is an explicit dependency. It combines all this information into a single, searchable, and
    actionable dashboard for full lifecycle package management.

    ## Key Features

    * **Unified View:** Merges the output of `pacman -Sl` (all packages) and `pacman -Qe` (explicitly installed)
      to provide a comprehensive view of the system's package state.
    * **Full Lifecycle Management:** Provides intuitive key bindings to install (`-S`), remove (`-Rcs`), upgrade
      (`-Syu`), and change the dependency status (`-D --asdeps/--asexplicit`) of packages.
    * **Informative Preview:** The preview window shows detailed package information (`pacman -Qi` or `-Si`) and lists
      the files owned by the package (`pacman -Ql` or `-Fl`).
    * **Clean & Composable:** Follows the three-mode pattern, allowing it to be used as an interactive TUI, a static
      table generator, or a pure JSON data source.

# => MVC ---------------------------------------------------------------------------------------------------------- {{{1

# Generate a unified JSON list of all available and installed packages
model:
    #!/usr/bin/env -S bash -Eeuo pipefail
    pacman -Sl | "$this" merge-pacman-data <(pacman -Qe)

# Print available and installed packages as a formatted and colorized table
view:
    #!/usr/bin/env -S bash -Eeuo pipefail
    jq_fields=(
        '_id;\(.name)'
        '_url;\(if .repo == "aur" then "https://aur.archlinux.org/packages/" else "https://archlinux.org/packages/?q=" end + .name)'
        'name;\(.name)'
        'status;\(if .explicit then "explicit" elif .installed then "dependency" else "" end);yellow'
        'repo;\(.repo);gray'
    )
    "$this" model | "$this" json::to-table 'sort_by((.explicit | not), (.installed | not), .name)' "${jq_fields[@]}"

# Display the interactive TUI for managing pacman packages
controller:
    #!/usr/bin/env -S bash -Eeuo pipefail
    export FZF_RELOAD_CMD="${this@Q} view"
    upgrade_cmd='sudo pacman -Syu --noconfirm --needed && sudo pacman -Fy'
    fzf_args=(
        --bind="alt-A:execute(${this@Q} fzf::run-reload -ft 1 -- sudo pacman -S {+1})"
        --bind="alt-C:execute(${this@Q} fzf::run-reload -f    -- arch prune)"
        --bind="alt-D:execute(${this@Q} fzf::run-reload -ft 1 -- sudo pacman -D --asdeps {+1})"
        --bind="alt-E:execute(${this@Q} fzf::run-reload -ft 1 -- sudo pacman -D --asexplicit {+1})"
        --bind="alt-R:execute(${this@Q} fzf::run-reload -ft 1 -- sudo pacman -Rcs {+1})"
        --bind="alt-U:execute(echo ${upgrade_cmd@Q} | ${this@Q} fzf::run-reload -ft 1)"
        --bind="alt-i:execute(${this@Q} preview {1} {4} | ${PAGER:-less})"
        --bind="alt-t:become(menu-aur)"
        --bind="ctrl-m:become(echo {+1})"
        --footer="A-A:install A-C:clean A-D:asdep A-E:asexp A-R:remove A-U:upgrade A-i:inspect A-t:AUR"
        --preview="${this@Q} preview {1} {4}"
        --prompt="pacman > "
        --with-nth="3.."
    )
    "$this" view | "$this" fzf::table-multi "${fzf_args[@]}"

# => helper ------------------------------------------------------------------------------------------------------- {{{1

# Show package information
[private]
preview package status:
    #!/usr/bin/env -S bash -Eeuo pipefail
    if [[ -n "$status" ]]; then
        pacman -Qi "$package"
        pacman -Ql "$package" | perl -aE 'say $F[1]'
    else
        pacman -Si "$package"
        pacman -Fl "$package" | perl -aE 'say $F[1]'
    fi

# Merge `pacman -Sl` and `pacman -Qe` output into a single JSON stream
[private, positional-arguments]
merge-pacman-data explicitly_installed:
    #!/usr/bin/env -S perl -CALS -lan
    use v5.40;

    our (%e, @r, $json_class);
    BEGIN {
        # use better JSON module by default if available
        $json_class = eval {require Cpanel::JSON::XS; 'Cpanel::JSON::XS'} || do {require JSON::PP; 'JSON::PP'};
        %e = map {chomp; (split)} <<>>;
    }

    use constant {
        JSON_ONE_LINE => $json_class->new->canonical->utf8(0)->pretty(0)->indent(0),
    };

    push @r, {repo => $F[0], name => $F[1], version => $F[2], installed => !!$F[3], explicit => !!(delete $e{$F[1]})};

    END {
        push @r, {repo => 'aur', name => $_, version => $e{$_}, installed => true, explicit => true} foreach keys %e;
        say JSON_ONE_LINE()->encode(\@r)
    }
