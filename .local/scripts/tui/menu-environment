#!/usr/bin/env -S just --one --unstable --justfile

# https://just.systems/man/en/

mod common "~/.local/lib/just/common"
mod fzf "~/.local/lib/just/fzf"
mod json "~/.local/lib/just/json"

set export
set no-cd

export colored-md := require('colored-md') # https://github.com/andrew-grechkin/colored-md
export text_split := require('text-split')
export this := justfile()
export tui := 'auto'

# => default ------------------------------------------------------------------------------------------------------ {{{1

# Run TUI if interactive, otherwise print static view
[private]
default:
    #!/usr/bin/env -S bash -Eeuo pipefail
    if [[ "$tui" == 'force' ]] || [[ "$tui" == 'auto' && -t 1 ]]; then
        "$this" controller
    else
        "$this" view
    fi

# Print help
help:
    #!/usr/bin/env -S colored-md

    # ABSTRACT

    Interactive TUI for browsing and inspecting environment variables

    # DESCRIPTION

    `menu-environment` provides a fast, searchable interface for exploring the environment variables in the current
    shell session.

    It solves the problem of running `env` and getting a dense, hard-to-read wall of text. It presents the
    variables in a clean, interactive list with a powerful preview that intelligently formats path-like variables.

    ## Key Features

    * **Fuzzy Search:** Instantly search for variables by name.
    * **Intelligent Preview:** The preview window displays the full variable value and automatically splits known
      path variables (like `$PATH`, `$FPATH`) by colons for easy inspection.
    * **Clipboard Integration:** Easily copy the full value of any variable to the clipboard.
    * **Clean & Composable:** Follows the three-mode pattern, allowing it to be used as an interactive TUI, a static
      table generator, or a pure JSON data source.

# => MVC ---------------------------------------------------------------------------------------------------------- {{{1

# Output all environment variables as a single JSON array
model:
    #!/usr/bin/env -S bash -Eeuo pipefail
    memoize -wl "${FZF_CURRENT_SNAPSHOT_ID:-$$}" -- env -0 \
        | jq -R -s 'split("\u0000") | .[:-1] | map(split("=") | {key: .[0], value: (.[1:] | join("="))})'

# Print environment variables as a formatted and colorized table
view:
    #!/usr/bin/env -S bash -Eeuo pipefail
    jq_fields=(
        '_key;\(.key)'
        '_url;'
        'key;\(.key);yellow'
        'value;\(.value | if (length > 99) then .[0:99] + "…" else . end);silver'
    )
    "$this" model | "$this" json::to-table 'sort_by(.key)' "${jq_fields[@]}"

# Display the interactive TUI for browsing environment variables
controller:
    #!/usr/bin/env -S bash -Eeuo pipefail
    # NOTE: snapshot prevents FZF from injecting new or changing existing variables on reload
    export FZF_CURRENT_SNAPSHOT_ID="${FZF_CURRENT_SNAPSHOT_ID:-$$}"
    export FZF_RELOAD_CMD="${this@Q} view"

    fzf_args=(
        --bind="alt-b:execute-silent:true"
        --bind="alt-i:execute(${this@Q} preview-environment-variable {1} | ${PAGER:-less})"
        --bind="alt-y:execute-silent(v={4}; echo -n ' export '{3}'='\"\${v@Q}\" | clipcopy)"
        --bind="ctrl-m:become(echo {4})"
        --bind="ctrl-y:execute-silent(echo -n {4} | clipcopy)"
        --footer="A-i:inspect A-y:export C-y:yank enter:print"
        --header-lines=1
        --preview-window="right:60%:border-left:wrap"
        --preview="${this@Q} preview-environment-variable {1}"
        --prompt="env > "
        --with-nth="3.."
    )
    "$this" view | "$this" fzf::table "${fzf_args[@]}"

# => helper ------------------------------------------------------------------------------------------------------- {{{1

# Generate a formatted preview for a single environment variable
[private]
preview-environment-variable key:
    #!/usr/bin/env -S bash -Eeuo pipefail
    "$this" model \
        | jq --arg key "$key" '.[] | select(.key == $key)' \
        | "$this" preview-json

# Generate a formatted preview for a json provided to STDIN
[private]
preview-json:
    #!/usr/bin/env -S bash -Eeuo pipefail
    parse='DIRS$|LIB$|PATHS?$|FPATH$|MANPATH$|^LS_COLORS$|^KUBECONFIG$'
    # NOTE: don't use jaq here because it's quirks in `fromjson` function
    # 1. strings started from # are converted to null (not throwing)
    # 2. partial numbers are producing list of 2 elements
    jq --arg parse "$parse" '
            .key as $key | .value as $value |
                . + if ($key | test($parse; "") and ($value | test(":"))) then
                    {parsed_value: ($value | split(":"))}
                end
                + {value: (try ($value | fromjson) catch $value)}
        ' | json2yaml | colored-yaml
