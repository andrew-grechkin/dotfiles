# Build content items (text descriptor plus media part) for the provided path
[group('helper'), private]
file-content path:
    #!/usr/bin/env -S bash -Eeuo pipefail
    mime="$(file -b --mime-type "$path")"
    size="$(wc -c < "$path")"
    name="$(basename "$path")"
    if [[ "$mime" == image/* ]]; then
        jq -ncS --rawfile d <(base64 -w0 "$path") \
                --arg m "$mime" --arg p "$path" --arg s "$size" '
            [
                {"type": "text", "text": ("this is a file (path: " + $p + ", size in bytes: " + $s + ")")},
                {"type": "image_url", "image_url": {"url": ("data:" + $m + ";base64," + $d)}}
            ]'
    else
        jq -ncS --rawfile d <(base64 -w0 "$path") \
                --arg m "$mime" --arg p "$path" --arg s "$size" --arg n "$name" '
            [
                {"type": "text", "text": ("this is a file (path: " + $p + ", size in bytes: " + $s + ")")},
                {"type": "file", "file": {"file_data": ("data:" + $m + ";base64," + $d), "filename": $n}}
            ]'
    fi

