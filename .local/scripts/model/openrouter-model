# => http --------------------------------------------------------------------------------------------------------- {{{1

[group('http'), private]
api-key:
    #!/usr/bin/env -S bash -Eeuo pipefail
    if [[ -n "${OPENROUTER_API_KEY:-}" ]]; then
        echo "$OPENROUTER_API_KEY"
    else
        "$credp" "token://$OPENROUTER_HOST" || {
            "$this" common::fatal "unable to init openrouter api key.
                Export key directly via OPENROUTER_API_KEY variable"
        }
    fi

[group('http'), private, positional-arguments]
http-request method uri *argv:
    #!/usr/bin/env -S bash -Eeuo pipefail
    shift 2
    [[ "$uri" == /* ]] && uri="$OPENROUTER_HOST$OPENROUTER_API${uri#${OPENROUTER_API}}"
    "$this" http::request "$method" "$uri" --auth-type=bearer --auth="$("$this" api-key)" "$@"

[group('http'), private, positional-arguments]
http-request-cached method uri *argv:
    #!/usr/bin/env -S bash -Eeuo pipefail
    shift 2
    [[ "$uri" == /* ]] && uri="$OPENROUTER_HOST$OPENROUTER_API${uri#${OPENROUTER_API}}"
    cmd=(
        "$this" http::request "$method" "$uri"
        --no-ignore-stdin
        --auth-type=bearer
        --auth="$("$this" api-key)"
        "$@"
    )
    payload="$(cat)"
    memoize -l "$(md5sum <<< "$payload")" -- "${cmd[@]}" <<< "$payload"

[group('http'), private, positional-arguments]
http-stream method uri *argv:
    #!/usr/bin/env -S bash -Eeuo pipefail
    shift 2
    [[ "$uri" == /* ]] && uri="$OPENROUTER_HOST$OPENROUTER_API${uri#${OPENROUTER_API}}"
    cmd=(
        "$this" http::request-streaming "$method" "$uri"
        --no-ignore-stdin
        --auth-type=bearer
        --auth="$("$this" api-key)"
        "$@"
    )
    payload="$(cat)"
    memoize -l "$(md5sum <<< "$payload")" -- "${cmd[@]}" <<< "$payload"

# Send request with data already prepared as a valid chat-completions body via STDIN
[group('text')]
prepared-request:
    #!/usr/bin/env -S bash -Eeu
    jq -ncS --slurpfile req <(cat) --argjson instructions "$("$this" default-instructions)" '
        $req[0] + {messages: ([$instructions] + ($req[0].messages // []))}
    ' | "$this" http-request-cached POST "/chat/completions"

# Send request with raw text data and streaming response
[group('http'), private]
streamed-request:
    #!/usr/bin/env -S bash -Eeu
    jq -ncS '{"model": $model, "messages": ([$instructions] + [{"role": "user", "content": $prompt}]), "stream": true}' \
            --arg model "$OPENROUTER_MODEL" \
            --argjson instructions "$("$this" default-instructions)" \
            --rawfile prompt <(cat) \
        | "$this" http-stream POST "/chat/completions"

# Send request with raw text data
[group('http'), private]
raw-request:
    #!/usr/bin/env -S bash -Eeu
    jq -ncS '{"model": $model, "messages": ([$instructions] + [{"role": "user", "content": $prompt}])}' \
            --arg model "$OPENROUTER_MODEL" \
            --argjson instructions "$("$this" default-instructions)" \
            --rawfile prompt <(cat) \
        | "$this" http-request-cached POST "/chat/completions"

