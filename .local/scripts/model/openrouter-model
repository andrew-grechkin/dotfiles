    memoize -- "$this" http-request GET '/models/count'

# List all endpoints for a model (author/slug)
[group('models')]
list-model-endpoints model:
    #!/usr/bin/env -S bash -Eeu
    "$this" http-request GET "/models/$model/endpoints"

# List models filtered by user provider preferences, privacy settings and guardrails
[group('models')]
list-user-models *query:
    #!/usr/bin/env -S bash -Eeu
    memoize -- "$this" http-request GET '/models/user' "$@"

# List all embeddings models
[group('models')]
list-embeddings-models:
    #!/usr/bin/env -S bash -Eeu
    memoize -- "$this" http-request GET '/embeddings/models'

# Print effective default model (chat model when OR_CHAT is set, otherwise the configured default)
[group('models')]
default-model:
    #!/usr/bin/env -S bash -Eeuo pipefail
    if [[ -n "${OR_CHAT:-}" && -r "$OR_STATE/$OR_CHAT/history.json" ]]; then
        model=$(jq -r '.model // empty' "$OR_STATE/$OR_CHAT/history.json")
        [[ -z "$model" ]] || { echo "$model"; exit 0; }
    fi
    echo "$OPENROUTER_MODEL"

# => providers ---------------------------------------------------------------------------------------------------- {{{1

# List available providers
[group('providers')]
list-providers:
    #!/usr/bin/env -S bash -Eeu
    memoize -- "$this" http-request GET '/providers'

# => tools -------------------------------------------------------------------------------------------------------- {{{1

# List server tools OpenRouter can run on behalf of a model
[group('tools')]
list-tools *query:
    #!/usr/bin/env -S bash -Eeu
    "$this" http-request GET '/tools' "$@"

# Get a server tool by canonical name or alias
[group('tools')]
get-tool name:
