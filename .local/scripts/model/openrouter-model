#!/usr/bin/env -S just --one --justfile

# ABSTRACT: access OpenRouter API from cli
# https://openrouter.ai/docs

mod common "~/.local/lib/just/common"
mod http "~/.local/lib/just/http"

set export
set no-cd

export clipcopy := require('clipcopy')
export colored-md := require('colored-md')
export credp := require('credp')
export ifne := require('ifne')
export jq := require('jq')
export sponge := require('sponge')
export this := justfile()

export OPENROUTER_HOST := env('OPENROUTER_HOST', 'openrouter.ai')
export OPENROUTER_API := env('OPENROUTER_API', '/api/v1')
export OPENROUTER_MODEL := env('OPENROUTER_MODEL', 'deepseek/deepseek-v4.1-flash')
export OPENROUTER_EMBEDDING_MODEL := env('OPENROUTER_EMBEDDING_MODEL', 'openai/text-embedding-3-small')
export OPENROUTER_RERANK_MODEL := env('OPENROUTER_RERANK_MODEL', 'cohere/rerank-v3.5')
export OPENROUTER_TTS_MODEL := env('OPENROUTER_TTS_MODEL', 'openai/gpt-4o-mini-tts-2025-12-15')
export OPENROUTER_TTS_VOICE := env('OPENROUTER_TTS_VOICE', 'alloy')
export OPENROUTER_TTS_FORMAT := env('OPENROUTER_TTS_FORMAT', 'mp3')
export OPENROUTER_STT_MODEL := env('OPENROUTER_STT_MODEL', 'openai/whisper-1')
export OPENROUTER_IMAGE_MODEL := env('OPENROUTER_IMAGE_MODEL', 'openai/gpt-image-1')
export OR_STATE := config_directory() + '/or'

# => default ------------------------------------------------------------------------------------------------------ {{{1

[private]
@default:
    "$this" --list

# => api ---------------------------------------------------------------------------------------------------------- {{{1

# Fetch the OpenAPI specification
[group('api')]
swagger:
    #!/usr/bin/env -S bash -Eeu
    memoize -- "$this" http-request GET 'openrouter.ai/openapi.json'

# List documented endpoints as ansi table, optionally filtered by case-insensitive regex
[group('api')]
endpoints pattern='.':
    #!/usr/bin/env -S bash -Eeuo pipefail
    "$this" swagger \
        | jq -r --arg host "$OPENROUTER_HOST" --arg api "$OPENROUTER_API" '
            ((.servers // [])[0].url // ("https://" + $host + $api)) as $base
            | .paths | to_entries[]
            | .key as $path
            | .value | to_entries[]
            | select(.key | test("^(get|put|post|delete|head|patch|options|trace)$"; "i"))
            | [(.key | ascii_upcase), ($base + $path), (.value.summary // "")]
            | @tsv
        ' \
        | grep -iE -- "$pattern" \
        | sort -k2,2 -k1,1 \
        | column -t -s $'\t'

# => chat --------------------------------------------------------------------------------------------------------- {{{1

# Return history or partial history of a specific chat
[group('chat')]
history name from='0' to='':
    #!/usr/bin/env -S bash -Eeuo pipefail
    history_file="$OR_STATE/$name/history.json"
    [[ -s "$history_file" ]] || "$this" init-history "$history_file"
    jq -r '.messages[{{from}}:{{to}}][] | select(.role != "system") | (
        .role as $r
        | (if (.content | type) == "array"
             then (.content | map(select(.type == "text") | .text) | join("\n"))
             else (.content // "")
           end)
        | trim? | split("\n")[] | if $r == "user" then "\n# PROMPT: " else "" end + .
    )' "$history_file"

# Render full chat to ansi text representation
[group('chat')]
render-chat name from='0' to='':
    #!/usr/bin/env -S bash -Eeuo pipefail
    "$this" history "$name" "$from" "$to" \
        | colored-md

# Render chat dialog turn to ansi text representation for fzf with index
[group('chat'), no-exit-message]
render-turn name index='-1':
    #!/usr/bin/env -S bash -Eeuo pipefail
    history_file="$OR_STATE/$name/history.json"
    [[ -s "$history_file" ]] || "$this" init-history "$history_file"
    jq_script=$(cat << 'EO_JQ_SCRIPT'
        (.messages // []) as $m
        | ($m | length) as $len
        | (if ($from < 0 or $from >= $len) then $len - 1 else $from end) as $from
        | (($m | to_entries | map(select(.value.role == "user") | .key)) + [$len]) as $starts
        | ([range(0; ($starts | length) - 1) | [$starts[.], $starts[. + 1]]]
            | map(select(.[0] <= $from and $from < .[1]))[0]) as $bounds
        | $m[$bounds[0] : $bounds[1]]
        | to_entries[]
        | {
            index: ($bounds[0] + .key),
            role: .value.role,
            text: (
                (.value.content
                    | if type == "array" then
                        (map(select(.type == "text") | .text) | join("\n"))
                      else (. // "")
                      end)
            ),
            images: (
                (.value.content
                    | if type == "array" then
                        map(select(.type == "image_url") | .image_url.url
                            | select(type == "string" and startswith("data:"))
                            | sub("^data:[^;]+;base64,"; ""))
                      else []
                      end)
            )
          }
        | if .role == "user" then .text |= "# " + . else . end
    EO_JQ_SCRIPT
    )
    jq -c --argjson from "$index" "$jq_script" "$history_file" | while read -r line; do
        {
            jq -r '.text' <<< "$line" | colored-md
            echo
            while read -r picture; do
                [[ -n "$picture" ]] || continue
                # NOTE: fzf man lies about FZF_COLUMNS: the number includes padding and margin (marker and scrollbar)
                # and thus cannot be used without substracting at least 3 columns
                base64 -d <<< "$picture" \
                    | chafa -f symbols --view-size "$(( ${FZF_COLUMNS:-$(tput cols)} - 8 ))"
                echo
            done < <(jq -r '.images[]?' <<< "$line")
        } | if [[ -n "${NO_PREFIX:-}" ]]; then
            cat
        else
            prefix="$(jq -r '"\(.index)\t\(.role)\t"' <<< "$line")"
            perl -nE "print qq{$prefix}, \$_"
        fi
    done

# Remove last item in the chat
[group('chat')]
remove-last-content name:
    #!/usr/bin/env -S bash -Eeuo pipefail
    history_file="$OR_STATE/$name/history.json"
    [[ -s "$history_file" ]] && {
        jq '.messages |= del(.[-1])' "$history_file" \
            | ifne sponge "$history_file"
    }

# Request AI to give response to the chat
[group('chat')]
update-chat name:
    #!/usr/bin/env -S bash -Eeuo pipefail
    history_file="$OR_STATE/$name/history.json"
    [[ -s "$history_file" ]] || "$this" init-history "$history_file"
    if res=$("$this" http-request POST "/chat/completions" --no-ignore-stdin < "$history_file"); then
        jq -nS '$history[] | .messages += $model' \
                --slurpfile model <(jq '.choices[0].message' <<< "$res") \
                --slurpfile history "$history_file" \
            | ifne sponge "$history_file"
    fi

# Update chat contents with new data
[group('chat')]
add-to-chat name content role='user':
    #!/usr/bin/env -S bash -Eeuo pipefail
    history_file="$OR_STATE/$name/history.json"
    [[ -s "$history_file" ]] || "$this" init-history "$history_file"
    jq -nS --arg role "$role" --arg content "$content" \
        --slurpfile history "$history_file" '
        $history[] | .messages += [{"role": $role, "content": $content}]
    ' | ifne sponge "$history_file"

# Update chat contents with new content items provided via STDIN as a JSON array
[group('chat')]
add-parts-to-chat name role='user':
    #!/usr/bin/env -S bash -Eeuo pipefail
    history_file="$OR_STATE/$name/history.json"
    [[ -s "$history_file" ]] || "$this" init-history "$history_file"
    jq -nS --arg role "$role" --slurpfile items <(cat) --slurpfile history "$history_file" '
        ($items[0] // []) as $new
        | $history[]
        | if (.messages[-1]?.role == $role) then
              .messages[-1].content = (
                  (if (.messages[-1].content | type) == "array" then .messages[-1].content
                   else [{"type": "text", "text": (.messages[-1].content // "")}]
                   end) + $new
              )
          else
              .messages += [{"role": $role, "content": $new}]
          end
    ' | ifne sponge "$history_file"

# Add request (plain text provided via STDIN) to the chat
[group('chat')]
add-request-to-chat name:
    #!/usr/bin/env -S bash -Eeuo pipefail
    jq -ncS --rawfile request <(cat) '[{"type": "text", "text": $request}]' \
        | "$this" add-parts-to-chat "$name" user

# Add text to the chat, not request but additional information to request (clipboard for example)
[group('chat')]
add-text-to-chat name display_name type='text':
    #!/usr/bin/env -S bash -Eeuo pipefail
    jq -ncS --rawfile d <(base64 -w0) --arg n "$display_name" --arg t "$type" '
    [
        {"type": "text", "text": "this is a \($t): \($n)"},
        {"type": "text", "text": ($d | @base64d)}
    ]' | "$this" add-parts-to-chat "$name"

# Add file to the chat (inline, base64-encoded)
[group('chat')]
add-file-to-chat name path:
    #!/usr/bin/env -S bash -Eeuo pipefail
    "$this" file-content "$path" \
        | "$this" add-parts-to-chat "$name"

# Add file to the chat via server-side upload (for large files)
[group('chat')]
add-server-side-file-to-chat name path:
    #!/usr/bin/env -S bash -Eeuo pipefail
    file_id=$("$this" upload-file "$path" | jq -r '.id // empty')
    [[ -n "$file_id" ]] || exec "$this" common::fatal "unable to upload file: $path"
    jq -ncS --arg id "$file_id" --arg p "$path" '
    [
        {"type": "text", "text": ("this is a server-side file (path: " + $p + ")")},
        {"type": "file", "file": {"file_id": $id}}
    ]' | "$this" add-parts-to-chat "$name"

# Request AI to give streamed response to the chat
[group('chat')]
stream-chat name:
    #!/usr/bin/env -S bash -Eeuo pipefail
    history_file="$OR_STATE/$name/history.json"
    [[ -s "$history_file" ]] || "$this" init-history "$history_file"
    jq -S '. + {stream: true}' "$history_file" \
        | "$this" http-stream POST "/chat/completions"

# Update chat contents with new streamed SSE data
[group('chat')]
add-sse-to-chat name:
    #!/usr/bin/env -S bash -Eeuo pipefail
    history_file="$OR_STATE/$name/history.json"
    [[ -s "$history_file" ]] || "$this" init-history "$history_file"
    jq -rj '.choices[0].delta.content // empty' \
        | jq -Rs --slurpfile history "$history_file" '
            . as $delta
            | $history[]
            | if (.messages[-1]?.role == "assistant") then
                  .messages[-1].content = ((.messages[-1].content // "") + $delta)
              else
                  .messages += [{"role": "assistant", "content": $delta}]
              end
        ' | ifne sponge "$history_file"

# Initialize chat history file with model and system instructions unless it already exists
[group('chat')]
init-history history_file:
    #!/usr/bin/env -S bash -Eeuo pipefail
    [[ -s "$history_file" ]] || {
        mkdir -p "$(dirname "$history_file")"
        jq -nS '{"model": $model, "messages": [$instructions]}' \
            --arg model "$OPENROUTER_MODEL" \
            --argjson instructions "$("$this" default-instructions)" \
            > "$history_file"
    }

# => files -------------------------------------------------------------------------------------------------------- {{{1

# List server-side files
[group('files')]
list-files *query:
    #!/usr/bin/env -S bash -Eeu
    "$this" http-request GET "/files" "$@"

# Delete a server-side file
[group('files')]
delete-file id:
    #!/usr/bin/env -S bash -Eeu
    "$this" http-request DELETE "/files/$id"

# Upload a server-side file
[group('files')]
upload-file path:
    #!/usr/bin/env -S bash -Eeu
    "$this" http-request POST "/files" --form "file@$path"

# Describe provided file according to prompt
[group('files'), positional-arguments]
describe file *prompt:
    #!/usr/bin/env -S bash -Eeuo pipefail
    shift
    prompt="${*:-Describe this file}"
    jq -ncS --slurpfile content <("$this" file-content "$file") --arg prompt "$prompt" '
        {"messages": [{"role": "user", "content": ($content[0] + [{"type": "text", "text": $prompt}])}]}
    ' \
        | "$this" prepared-request \
        | jq -r '.choices[0].message.content' \
        | colored-md

# => text --------------------------------------------------------------------------------------------------------- {{{1

# Make a prompt
[group('text'), positional-arguments]
prompt *prompt:
    #!/usr/bin/env -S bash -Eeuo pipefail
    {
        [[ -z "$*" ]] || echo "$*"
        [[ -t 0    ]] || cat
    } | "$this" raw-request \
        | jq -r '.choices[0].message.content' \
        | colored-md

# Make a streamed prompt
[group('text'), positional-arguments]
streamed-prompt *prompt:
    #!/usr/bin/env -S bash -Eeuo pipefail
    {
        [[ -z "$*" ]] || echo "$*"
        [[ -t 0    ]] || cat
    } | "$this" streamed-request \
        | grep --line-buffered -Po '^data: \K.+' \
        | while read -r line; do
            if [[ "$line" == "[DONE]" ]]; then
                break
            fi
            jq -rj '.choices[0].delta.content // empty' <<< "$line"
        done

# Rephrase text provided via STDIN
[group('text'), positional-arguments]
rephrase *prompt:
    #!/usr/bin/env -S bash -Eeuo pipefail
    jq -ncS '{"model": $model, "messages": ([$instructions] + [{"role": "user", "content": $req + $prompt + ":\n" + $stdin}])}' \
            --arg model "$OPENROUTER_MODEL" \
            --argjson instructions "$("$this" rephrase-instructions)" \
            --arg req "Follow your instructions and rephrase the provided text " \
            --rawfile prompt <([[ -z "$*" ]] || echo -n "$*") \
            --rawfile stdin  <([[ -t 0    ]] || cat) \
        | "$this" http-request POST "/chat/completions" --no-ignore-stdin \
        | jq -r '.choices[0].message.content' \
        | "$this" common::trim-stream \
        | clipcopy

# Rephrase prompt in a polite way
[group('text'), positional-arguments]
polite *prompt:
    #!/usr/bin/env -S bash -Eeuo pipefail
    jq -ncS '{"model": $model, "messages": ([$instructions] + [{"role": "user", "content": $req + $prompt + $stdin}])}' \
            --arg model "$OPENROUTER_MODEL" \
            --argjson instructions "$("$this" rephrase-instructions)" \
            --arg req "Follow your instructions and rephrase the provided text in a formal and polite language:\n" \
            --rawfile prompt <([[ -z "$*" ]] || echo -n "$*") \
            --rawfile stdin  <([[ -t 0    ]] || cat) \
        | "$this" http-request POST "/chat/completions" --no-ignore-stdin \
        | jq -r '.choices[0].message.content' \
        | "$this" common::trim-stream \
        | clipcopy

# Finalize a provided prompt
[group('text'), positional-arguments]
finalize *prompt:
    #!/usr/bin/env -S bash -Eeuo pipefail
    jq -ncS '{"model": $model, "messages": ([$instructions] + [{"role": "user", "content": $req + $prompt + $stdin}])}' \
            --arg model "$OPENROUTER_MODEL" \
            --argjson instructions "$("$this" finalize-instructions)" \
            --arg req "Follow your instructions and finalize the provided text:" \
            --rawfile prompt <([[ -z "$*" ]] || echo -n "$*") \
            --rawfile stdin  <([[ -t 0    ]] || cat) \
        | "$this" http-request POST "/chat/completions" --no-ignore-stdin \
        | jq -r '.choices[0].message.content'

# Suggest a commit message based on a git diff
[group('text')]
suggest-commit-msg:
    #!/usr/bin/env -S bash -Eeuo pipefail
    jq -ncS '{"model": $model, "messages": ([$instructions] + [{"role": "user", "content": "Here is the diff:\n" + $prompt}])}' \
            --arg model "$OPENROUTER_MODEL" \
            --argjson instructions "$("$this" commit-msg-instructions)" \
            --rawfile prompt <(cat) \
        | "$this" http-request POST "/chat/completions" --no-ignore-stdin \
        | jq -r '.choices[0].message.content'

# Detect geo location
[group('text'), positional-arguments]
locate *prompt:
    #!/usr/bin/env -S bash -Eeuo pipefail
    jq -ncS '{"model": $model, "messages": ([$instructions] + [{"role": "user", "content": $req + $prompt + $stdin}])}' \
            --arg model "$OPENROUTER_MODEL" \
            --argjson instructions "$("$this" geolocate-instructions)" \
            --arg req "For the provided below description provide a response by strictly following instructions:\n" \
            --rawfile prompt <([[ -z "$*" ]] || echo -n "$*") \
            --rawfile stdin  <([[ -t 0    ]] || cat) \
        | "$this" http-request POST "/chat/completions" --no-ignore-stdin \
        | jq -r '.choices[0].message.content'

# Generate embeddings for provided text
[group('text')]
embeddings:
    #!/usr/bin/env -S bash -Eeu
    jq -ncS '{"model": $model, "input": $input}' \
            --arg model "$OPENROUTER_EMBEDDING_MODEL" \
            --rawfile input <(cat) \
        | "$this" http-request POST "/embeddings" --no-ignore-stdin

# Rerank documents based on query
[group('text'), positional-arguments]
rerank query *documents:
    #!/usr/bin/env -S bash -Eeu
    shift
    jq -ncS '{"model": $model, "query": $query, "documents": $docs}' \
            --arg model "$OPENROUTER_RERANK_MODEL" \
            --arg query "$query" \
            --argjson docs "$(printf '%s\n' "$@" | jq -R . | jq -s .)" \
        | "$this" http-request POST "/rerank" --no-ignore-stdin

# => audio -------------------------------------------------------------------------------------------------------- {{{1

# Text to speech
[group('audio'), positional-arguments]
tts *text:
    #!/usr/bin/env -S bash -Eeu
    jq -ncS '{"model": $model, "input": $input, "voice": $voice, "response_format": $format}' \
            --arg model "$OPENROUTER_TTS_MODEL" \
            --arg voice "$OPENROUTER_TTS_VOICE" \
            --arg format "$OPENROUTER_TTS_FORMAT" \
            --rawfile input <({ [[ -z "$*" ]] || echo "$*"; [[ -t 0 ]] || cat; }) \
        | "$this" http-stream POST "/audio/speech"

# Speech to text (transcription)
[group('audio')]
stt path:
    #!/usr/bin/env -S bash -Eeuo pipefail
    format="${path##*.}"
    jq -ncS '{"model": $model, "input_audio": {"data": $data, "format": $format}}' \
            --arg model "$OPENROUTER_STT_MODEL" \
            --arg format "${format,,}" \
            --rawfile data <(base64 -w0 "$path") \
        | "$this" http-request-cached POST "/audio/transcriptions"

# Read text (synthesize and play)
[group('audio'), positional-arguments]
read *argv:
    #!/usr/bin/env -S bash -Eeuo pipefail
    "$this" tts "$@" \
        | ifne mpv --no-video --msg-level=all=error -

# Read clipboard
[group('audio')]
read-clipboard:
    #!/usr/bin/env -S bash -Eeuo pipefail
    clippaste | "$this" read

# Read text to file
[group('audio'), positional-arguments]
read2file path *argv:
    #!/usr/bin/env -S bash -Eeuo pipefail
    shift
    "$this" tts "$@" \
        | ifne sponge "$path"

# => images ------------------------------------------------------------------------------------------------------- {{{1

# Generate image from prompt
[group('images'), positional-arguments]
generate-image *prompt:
    #!/usr/bin/env -S bash -Eeu
    jq -ncS '{"model": $model, "prompt": $prompt}' \
            --arg model "$OPENROUTER_IMAGE_MODEL" \
            --rawfile prompt <({ [[ -z "$*" ]] || echo "$*"; [[ -t 0 ]] || cat; }) \
        | "$this" http-request-cached POST "/images"

# List image generation models
[group('images')]
list-image-models:
    #!/usr/bin/env -S bash -Eeu
    memoize -- "$this" http-request GET '/images/models'

# List endpoints for an image model (author/slug)
[group('images')]
list-image-model-endpoints model:
