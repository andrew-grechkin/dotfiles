#!/usr/bin/env -S just --one --justfile

# ABSTRACT: access DeepSeek API from cli
# https://api-docs.deepseek.com/
# https://platform.deepseek.com/

mod common "~/.local/lib/just/common"
mod http "~/.local/lib/just/http"

set export
set no-cd

export clipcopy := require('clipcopy')
export colored-md := require('colored-md')
export credp := require('credp')
export fd := require('fd')
export ifne := require('ifne')
export jq := require('jq')
export sponge := require('sponge')
export this := justfile()

export DEEPSEEK_HOST := env('DEEPSEEK_HOST', 'api.deepseek.com')
export DEEPSEEK_API := env('DEEPSEEK_API', '')
export DEEPSEEK_BETA_API := env('DEEPSEEK_BETA_API', '/beta')
export DEEPSEEK_MODEL := env('DEEPSEEK_MODEL', 'deepseek-flash')
export DEEPSEEK_REASONING_EFFORT := env('DEEPSEEK_REASONING_EFFORT', 'high')
export DS_STATE := env('DS_STATE', config_directory() + '/ds')

# => default ------------------------------------------------------------------------------------------------------ {{{1

[private]
@default:
    "$this" --list

# => chat --------------------------------------------------------------------------------------------------------- {{{1

# Return history or partial history of a specific chat
[group('chat')]
history name from='0' to='':
    #!/usr/bin/env -S bash -Eeuo pipefail
    history_file="$DS_STATE/$name/history.json"
    [[ -s "$history_file" ]] || "$this" init-history "$history_file"
    jq -r '.messages[{{from}}:{{to}}][] | select(.role != "system") | (
        .role as $r
        | (if (.content | type) == "array"
             then (.content | map(select(.type == "text") | .text) | join("\n"))
             else (.content // "")
           end)
        | trim? | split("\n")[] | if $r == "user" then "\n# PROMPT: " else "" end + .
    )' "$history_file"

# Render full chat to ansi text representation
[group('chat')]
render-chat name from='0' to='':
    #!/usr/bin/env -S bash -Eeuo pipefail
    "$this" history "$name" "$from" "$to" \
        | colored-md

# Render chat dialog turn to ansi text representation for fzf with index
[group('chat'), no-exit-message]
render-turn name index='-1':
    #!/usr/bin/env -S bash -Eeuo pipefail
    history_file="$DS_STATE/$name/history.json"
    [[ -s "$history_file" ]] || "$this" init-history "$history_file"
    jq_script=$(cat << 'EO_JQ_SCRIPT'
        (.messages // []) as $m
        | ($m | length) as $len
        | (if ($from < 0 or $from >= $len) then $len - 1 else $from end) as $from
        | (($m | to_entries | map(select(.value.role == "user") | .key)) + [$len]) as $starts
        | ([range(0; ($starts | length) - 1) | [$starts[.], $starts[. + 1]]]
            | map(select(.[0] <= $from and $from < .[1]))[0]) as $bounds
        | $m[$bounds[0] : $bounds[1]]
        | to_entries[]
        | {
            index: ($bounds[0] + .key),
            role: .value.role,
            text: (
                (.value.content
                    | if type == "array" then
                        (map(select(.type == "text") | .text) | join("\n"))
                      else (. // "")
                      end)
            ),
            images: (
                (.value.content
                    | if type == "array" then
                        map(select(.type == "image_url") | .image_url.url
                            | select(type == "string" and startswith("data:"))
                            | sub("^data:[^;]+;base64,"; ""))
                      else []
                      end)
            )
          }
        | if .role == "user" then .text |= "# " + . else . end
    EO_JQ_SCRIPT
    )
    jq -c --argjson from "$index" "$jq_script" "$history_file" | while read -r line; do
        {
            jq -r '.text' <<< "$line" | colored-md
            echo
            while read -r picture; do
                [[ -n "$picture" ]] || continue
                # NOTE: fzf man lies about FZF_COLUMNS: the number includes padding and margin (marker and scrollbar)
                # and thus cannot be used without substracting at least 3 columns
                base64 -d <<< "$picture" \
                    | chafa -f symbols --view-size "$(( ${FZF_COLUMNS:-$(tput cols)} - 8 ))"
                echo
            done < <(jq -r '.images[]?' <<< "$line")
        } | if [[ -n "${NO_PREFIX:-}" ]]; then
            cat
        else
            prefix="$(jq -r '"\(.index)\t\(.role)\t"' <<< "$line")"
            perl -nE "print qq{$prefix}, \$_"
        fi
    done

# Remove last item in the chat
[group('chat')]
remove-last-content name:
    #!/usr/bin/env -S bash -Eeuo pipefail
    history_file="$DS_STATE/$name/history.json"
    [[ -s "$history_file" ]] && {
        jq '.messages |= del(.[-1])' "$history_file" \
            | ifne sponge "$history_file"
    }

# Request AI to give response to the chat
[group('chat')]
update-chat name:
    #!/usr/bin/env -S bash -Eeuo pipefail
    history_file="$DS_STATE/$name/history.json"
    [[ -s "$history_file" ]] || "$this" init-history "$history_file"
    if res=$("$this" http-request POST "/chat/completions" --no-ignore-stdin < "$history_file"); then
        jq -nS '$history[] | .messages += $model' \
                --slurpfile model <(jq '.choices[0].message' <<< "$res") \
                --slurpfile history "$history_file" \
            | ifne sponge "$history_file"
    fi

# Update chat contents with new data
[group('chat')]
add-to-chat name content role='user':
    #!/usr/bin/env -S bash -Eeuo pipefail
    history_file="$DS_STATE/$name/history.json"
    [[ -s "$history_file" ]] || "$this" init-history "$history_file"
    jq -nS --arg role "$role" --arg content "$content" \
        --slurpfile history "$history_file" '
        $history[] | .messages += [{"role": $role, "content": $content}]
    ' | ifne sponge "$history_file"

# Update chat contents with new content items provided via STDIN as a JSON array
[group('chat')]
add-parts-to-chat name role='user':
    #!/usr/bin/env -S bash -Eeuo pipefail
    history_file="$DS_STATE/$name/history.json"
    [[ -s "$history_file" ]] || "$this" init-history "$history_file"
    jq -nS --arg role "$role" --slurpfile items <(cat) --slurpfile history "$history_file" '
        ($items[0] // []) as $new
        | $history[]
        | if (.messages[-1]?.role == $role) then
              .messages[-1].content = (
                  (if (.messages[-1].content | type) == "array" then .messages[-1].content
                   else [{"type": "text", "text": (.messages[-1].content // "")}]
                   end) + $new
              )
          else
              .messages += [{"role": $role, "content": $new}]
          end
    ' | ifne sponge "$history_file"

# Add request (plain text provided via STDIN) to the chat
[group('chat')]
add-request-to-chat name:
    #!/usr/bin/env -S bash -Eeuo pipefail
    jq -ncS --rawfile request <(cat) '[{"type": "text", "text": $request}]' \
        | "$this" add-parts-to-chat "$name" user

# Add text to the chat, not request but additional information to request (clipboard for example)
[group('chat')]
add-text-to-chat name display_name type='text':
    #!/usr/bin/env -S bash -Eeuo pipefail
    jq -ncS --rawfile d <(base64 -w0) --arg n "$display_name" --arg t "$type" '
    [
        {"type": "text", "text": "this is a \($t): \($n)"},
        {"type": "text", "text": ($d | @base64d)}
    ]' | "$this" add-parts-to-chat "$name"

# Add image file to the chat (inline, base64-encoded). DeepSeek vision accepts images only
[group('chat')]
add-file-to-chat name path:
    #!/usr/bin/env -S bash -Eeuo pipefail
    "$this" file-content "$path" \
        | "$this" add-parts-to-chat "$name"

# Add file to the chat via server-side upload (for large images). Returns a file_id reference
[group('chat')]
add-server-side-file-to-chat name path:
    #!/usr/bin/env -S bash -Eeuo pipefail
    file_id=$("$this" upload-file "$path" | jq -r '.id // empty')
    [[ -n "$file_id" ]] || exec "$this" common::fatal "unable to upload file: $path"
    jq -ncS --arg id "$file_id" --arg p "$path" '
    [
        {"type": "text", "text": ("this is a server-side file (path: " + $p + ")")},
        {"type": "file", "file_id": $id}
    ]' | "$this" add-parts-to-chat "$name"

# Request AI to give streamed response to the chat
[group('chat')]
stream-chat name:
    #!/usr/bin/env -S bash -Eeuo pipefail
    history_file="$DS_STATE/$name/history.json"
    [[ -s "$history_file" ]] || "$this" init-history "$history_file"
    jq -S '. + {stream: true}' "$history_file" \
        | "$this" http-stream POST "/chat/completions"

# Update chat contents with new streamed SSE data (accumulates both content and reasoning_content)
[group('chat')]
add-sse-to-chat name:
    #!/usr/bin/env -S bash -Eeuo pipefail
    history_file="$DS_STATE/$name/history.json"
    [[ -s "$history_file" ]] || "$this" init-history "$history_file"
    mapfile -t lines
    join-delta() {
        printf '%s\n' "${lines[@]}" | jq -Rr --arg field "$1" '
            sub("^data: "; "")
            | select(length > 0 and . != "[DONE]")
            | (fromjson? | .choices[0].delta[$field] // empty)
        '
    }
    content="$(join-delta content)"
    reasoning="$(join-delta reasoning_content)"
    jq -nS --arg c "$content" --arg r "$reasoning" --slurpfile history "$history_file" '
        $history[]
        | if (.messages[-1]?.role == "assistant") then
              .messages[-1].content = ((.messages[-1].content // "") + $c)
              | .messages[-1].reasoning_content = (
                    ((.messages[-1].reasoning_content // "") + $r)
                    | if . == "" then null else . end
                )
          else
              .messages += [{
                  "role": "assistant",
                  "content": $c,
                  "reasoning_content": (if $r == "" then null else $r end)
              }]
          end
    ' | ifne sponge "$history_file"

# Initialize chat history file with model, thinking config and system instructions unless it already exists
[group('chat')]
init-history history_file:
    #!/usr/bin/env -S bash -Eeuo pipefail
    [[ -s "$history_file" ]] || {
        mkdir -p "$(dirname "$history_file")"
        jq -nS '{model: $model, messages: [$instructions]} + $reasoning[0]' \
            --arg model "$DEEPSEEK_MODEL" \
            --argjson instructions "$("$this" default-instructions)" \
            --slurpfile reasoning <("$this" reasoning) \
            > "$history_file"
    }

# => files -------------------------------------------------------------------------------------------------------- {{{1

# List server-side files (images uploaded via the Files API)
[group('files')]
list-files *query:
    #!/usr/bin/env -S bash -Eeu
    "$this" http-request GET "/files" "$@"

# Retrieve metadata of a server-side file
[group('files')]
get-file id:
    #!/usr/bin/env -S bash -Eeu
    "$this" http-request GET "/files/$id"

# Upload a server-side file (images only, purpose is fixed to user_data)
[group('files')]
upload-file path:
    #!/usr/bin/env -S bash -Eeu
    "$this" http-request POST "/files" --form "purpose=user_data" --form "file@$path"

# Delete a server-side file
[group('files')]
delete-file id:
    #!/usr/bin/env -S bash -Eeu
    "$this" http-request DELETE "/files/$id"

# Describe provided image according to prompt
[group('files'), positional-arguments]
describe file *prompt:
    #!/usr/bin/env -S bash -Eeuo pipefail
    shift
    prompt="${*:-Describe this file}"
    jq -ncS --slurpfile content <("$this" file-content "$file") --arg prompt "$prompt" '
        {"messages": [{"role": "user", "content": ($content[0] + [{"type": "text", "text": $prompt}])}]}
    ' \
        | "$this" prepared-request \
        | jq -r '.choices[0].message.content' \
        | colored-md

# => models ------------------------------------------------------------------------------------------------------- {{{1

# List available models
[group('models')]
list-models:
    #!/usr/bin/env -S bash -Eeu
    memoize -- "$this" http-request GET '/models'

# Print effective default model (chat model when DS_CHAT is set, otherwise the configured default)
[group('models')]
default-model:
    #!/usr/bin/env -S bash -Eeuo pipefail
    if [[ -n "${DS_CHAT:-}" && -r "$DS_STATE/$DS_CHAT/history.json" ]]; then
        model=$(jq -r '.model // empty' "$DS_STATE/$DS_CHAT/history.json")
        [[ -z "$model" ]] || { echo "$model"; exit 0; }
    fi
    echo "$DEEPSEEK_MODEL"

# => text --------------------------------------------------------------------------------------------------------- {{{1

# Make a prompt
[group('text'), positional-arguments]
prompt *prompt:
    #!/usr/bin/env -S bash -Eeuo pipefail
    {
        [[ -z "$*" ]] || echo "$*"
        [[ -t 0    ]] || cat
    } | "$this" raw-request \
        | jq -r '.choices[0].message.content' \
        | colored-md

# Make a streamed prompt
[group('text'), positional-arguments]
streamed-prompt *prompt:
    #!/usr/bin/env -S bash -Eeuo pipefail
    {
        [[ -z "$*" ]] || echo "$*"
        [[ -t 0    ]] || cat
    } | "$this" streamed-request \
        | grep --line-buffered -Po '^data: \K.+' \
        | while read -r line; do
            if [[ "$line" == "[DONE]" ]]; then
                break
            fi
            jq -rj '.choices[0].delta.content // empty' <<< "$line"
        done

# Rephrase text provided via `STDIN`
[group('text'), positional-arguments]
rephrase *prompt:
    #!/usr/bin/env -S bash -Eeuo pipefail
    jq -ncS '{model: $model, messages: ([$instructions] + [{"role": "user", "content": $req + $prompt + ":\n" + $stdin}])} + $reasoning[0]' \
            --arg model "$DEEPSEEK_MODEL" \
            --argjson instructions "$("$this" rephrase-instructions)" \
            --arg req "Follow your instructions and rephrase the provided text " \
            --rawfile prompt <([[ -z "$*" ]] || echo -n "$*") \
            --rawfile stdin  <([[ -t 0    ]] || cat) \
            --slurpfile reasoning <("$this" reasoning disabled) \
        | "$this" http-request POST "/chat/completions" --no-ignore-stdin \
        | jq -r '.choices[0].message.content' \
        | "$this" common::trim-stream \
        | clipcopy

# Rephrase prompt in a polite way
[group('text'), positional-arguments]
polite *prompt:
    #!/usr/bin/env -S bash -Eeuo pipefail
    jq -ncS '{model: $model, messages: ([$instructions] + [{"role": "user", "content": $req + $prompt + $stdin}])} + $reasoning[0]' \
            --arg model "$DEEPSEEK_MODEL" \
            --argjson instructions "$("$this" rephrase-instructions)" \
            --arg req "Follow your instructions and rephrase the provided text in a formal and polite language:\n" \
            --rawfile prompt <([[ -z "$*" ]] || echo -n "$*") \
            --rawfile stdin  <([[ -t 0    ]] || cat) \
            --slurpfile reasoning <("$this" reasoning disabled) \
        | "$this" http-request POST "/chat/completions" --no-ignore-stdin \
        | jq -r '.choices[0].message.content' \
        | "$this" common::trim-stream \
        | clipcopy

# Finalize a provided prompt
[group('text'), positional-arguments]
finalize *prompt:
    #!/usr/bin/env -S bash -Eeuo pipefail
    jq -ncS '{model: $model, messages: ([$instructions] + [{"role": "user", "content": $req + $prompt + $stdin}])} + $reasoning[0]' \
            --arg model "$DEEPSEEK_MODEL" \
            --argjson instructions "$("$this" finalize-instructions)" \
            --arg req "Follow your instructions and finalize the provided text:" \
            --rawfile prompt <([[ -z "$*" ]] || echo -n "$*") \
            --rawfile stdin  <([[ -t 0    ]] || cat) \
            --slurpfile reasoning <("$this" reasoning disabled) \
        | "$this" http-request POST "/chat/completions" --no-ignore-stdin \
        | jq -r '.choices[0].message.content'

# Suggest a commit message based on a git diff provided via `STDIN`
[group('text')]
suggest-commit-msg:
    #!/usr/bin/env -S bash -Eeuo pipefail
    jq -ncS '{model: $model, messages: ([$instructions] + [{"role": "user", "content": "Here is the diff:\n" + $prompt}])} + $reasoning[0]' \
            --arg model "$DEEPSEEK_MODEL" \
            --argjson instructions "$("$this" commit-msg-instructions)" \
            --rawfile prompt <(cat) \
            --slurpfile reasoning <("$this" reasoning disabled) \
        | "$this" http-request POST "/chat/completions" --no-ignore-stdin \
        | jq -r '.choices[0].message.content'

# => beta --------------------------------------------------------------------------------------------------------- {{{1

# FIM (Fill In the Middle) completion. Prefix is read from STDIN, optional suffix via argument (beta endpoint)
[group('beta'), positional-arguments]
fim suffix='':
    #!/usr/bin/env -S bash -Eeuo pipefail
    prefix="$(cat)"
    jq -ncS '{model: $model, prompt: $prefix} + (if $suffix == "" then {} else {suffix: $suffix} end)' \
            --arg model "$DEEPSEEK_MODEL" \
            --arg prefix "$prefix" \
            --arg suffix "$suffix" \
        | "$this" http-request-beta-cached POST "/completions" \
        | jq -r '.choices[0].text'

# Chat prefix completion. First argument is the assistant prefix to force, the prompt follows (beta endpoint)
[group('beta'), positional-arguments]
prefix assistant_prefix *prompt:
    #!/usr/bin/env -S bash -Eeuo pipefail
    jq -ncS '{model: $model, messages: [
            {"role": "user", "content": $prompt},
            {"role": "assistant", "content": $prefix, "prefix": true}
        ]} + $stop[0]' \
            --arg model "$DEEPSEEK_MODEL" \
            --arg prompt "$*" \
            --arg prefix "$assistant_prefix" \
            --slurpfile stop <("$this" stop-config) \
        | "$this" http-request-beta-cached POST "/chat/completions" \
        | jq -r '.choices[0].message.content'

# => edit --------------------------------------------------------------------------------------------------------- {{{1

# Agentic file editing via function tools (list_files, read_file, write_file, replace_in_file)
[group('edit'), positional-arguments]
edit *prompt:
    #!/usr/bin/env -S bash -Eeuo pipefail
    state="$(mktemp)"
    trap 'rm -f "$state"' EXIT
    jq -ncS --arg model "$DEEPSEEK_MODEL" --arg prompt "$*" \
            --argjson system "$("$this" default-instructions)" \
            --argjson editor "$("$this" edit-instructions)" \
            --slurpfile tools <("$this" edit-tools) '
        {model: $model, messages: [$system, $editor, {role: "user", content: $prompt}],
         tools: $tools[0].tools, thinking: {type: "disabled"}}
    ' > "$state"

    max_steps="${DEEPSEEK_EDIT_STEPS:-25}"
    for (( step = 1; step <= max_steps; step++ )); do
        res=$("$this" http-request POST "/chat/completions" --no-ignore-stdin < "$state")
        message="$(jq -c '.choices[0].message' <<< "$res")"
        tool_calls="$(jq -c '.tool_calls // empty' <<< "$message")"

        if [[ -z "$tool_calls" ]]; then
            jq -r '.content // empty' <<< "$message" | colored-md
            exit 0
        fi

        jq --argjson message "$message" '.messages += [$message]' "$state" | sponge "$state"

        while IFS= read -r call; do
            id="$(jq -r '.id' <<< "$call")"
            name="$(jq -r '.function.name' <<< "$call")"
            arguments="$(jq -r '.function.arguments // "{}"' <<< "$call")"
            result="$(printf '%s' "$arguments" | "$this" run-tool "$name" 2>&1)" \
                || result="ERROR: ${result:-tool call failed}"
            jq --arg id "$id" --arg result "$result" \
                '.messages += [{role: "tool", tool_call_id: $id, content: $result}]' "$state" \
                | sponge "$state"
        done < <(jq -c '.[]' <<< "$tool_calls")
    done

    "$this" common::fatal "edit agent exceeded $max_steps steps without a final answer"

# Execute a single function tool call. Arguments JSON is read from STDIN, result text is printed to STDOUT
[group('edit'), private, positional-arguments]
run-tool name:
    #!/usr/bin/env -S bash -Eeuo pipefail
    arguments="$(cat)"
    if ! jq -e . <<< "$arguments" >/dev/null 2>&1; then
        echo "invalid JSON arguments for $name: $arguments"
        exit 1
    fi

    guard-path() {
        local path="$1" root abs
        root="$(realpath -m -- "$PWD")"
        abs="$(realpath -m -- "$path")"
        if [[ -z "${DEEPSEEK_EDIT_UNSAFE:-}" && "$abs" != "$root"/* ]]; then
            echo "refusing to access path outside the working directory: $path (set DEEPSEEK_EDIT_UNSAFE=1 to override)" >&2
            return 1
        fi
        printf '%s' "$abs"
    }

    case "$name" in
        list_files)
            pattern="$(jq -r '.pattern' <<< "$arguments")"
            mapfile -t options < <(jq -r '.options[]?' <<< "$arguments")
            fd "${options[@]}" -- "$pattern"
            ;;
        read_file)
            path="$(jq -r '.path' <<< "$arguments")"
            file="$(guard-path "$path")" || exit 1
            [[ -f "$file" ]] || { echo "not a file: $path"; exit 1; }
            start="$(jq -r '.start_line // 1' <<< "$arguments")"
            end="$(jq -r '.end_line // 0' <<< "$arguments")"
            PERL_START="$start" PERL_END="$end" perl -ne '
                my $start = $ENV{PERL_START};
                my $end   = $ENV{PERL_END};
                print if $. >= $start && ($end <= 0 || $. <= $end);
            ' "$file"
            ;;
        write_file)
            path="$(jq -r '.path' <<< "$arguments")"
            file="$(guard-path "$path")" || exit 1
            mkdir -p -- "$(dirname -- "$file")"
            tmp="$(mktemp -- "${file}.XXXXXX")"
            jq -j '.content // ""' <<< "$arguments" > "$tmp"
            mv -- "$tmp" "$file"
            echo "wrote $(wc -c < "$file") bytes to $path"
            ;;
        replace_in_file)
            path="$(jq -r '.path' <<< "$arguments")"
            file="$(guard-path "$path")" || exit 1
            [[ -f "$file" ]] || { echo "not a file: $path"; exit 1; }
            (
                old_file="$(mktemp)"
                new_file="$(mktemp)"
                trap 'rm -f "$old_file" "$new_file"' EXIT
                jq -j '.old_string // ""' <<< "$arguments" > "$old_file"
                jq -j '.new_string // ""' <<< "$arguments" > "$new_file"
                replace_all="$(jq -r 'if (.replace_all // false) then "1" else "" end' <<< "$arguments")"
                perl -e '
                    use strict;
                    use warnings qw(FATAL utf8);
                    my ($path, $old_file, $new_file, $all) = @ARGV;
                    local $/;
                    open my $fh, "<", $path or die "cannot read $path: $!\n";
                    my $content = <$fh>;
                    close $fh;
                    open my $of, "<", $old_file or die "cannot read old_string\n";
                    my $old = <$of>;
                    close $of;
                    open my $nf, "<", $new_file or die "cannot read new_string\n";
                    my $new = <$nf>;
                    close $nf;
                    die "old_string must not be empty\n" if $old eq q{};
                    my $count = () = $content =~ /\Q$old\E/g;
                    die "old_string not found in $path\n" if $count == 0;
                    die "old_string is ambiguous ($count matches) in $path, provide more context or set replace_all\n"
                        if $count > 1 && !$all;
                    if ($all) {
                        $content =~ s/\Q$old\E/$new/g;
                    } else {
                        my $i = index $content, $old;
                        substr($content, $i, length $old) = $new;
                    }
                    my $tmp = "$path.tmp.$$";
                    open my $out, ">", $tmp or die "cannot write $tmp: $!\n";
                    print {$out} $content;
                    close $out or die "cannot close $tmp: $!\n";
                    rename $tmp, $path or die "cannot replace $path: $!\n";
                    print "replaced $count occurrence(s) in $path\n";
                ' "$file" "$old_file" "$new_file" "$replace_all"
            )
            ;;
        *)
            echo "unknown tool: $name"
            exit 1
            ;;
    esac

# => responses ---------------------------------------------------------------------------------------------------- {{{1

# Make a prompt via the Responses API
[group('responses'), positional-arguments]
responses-prompt *prompt:
    #!/usr/bin/env -S bash -Eeuo pipefail
    {
        [[ -z "$*" ]] || echo "$*"
        [[ -t 0    ]] || cat
    } | "$this" responses-request \
        | jq -r '.output[] | select(.type == "message") | .content[] | select(.type == "output_text") | .text' \
        | colored-md

# Make a streamed prompt via the Responses API
[group('responses'), positional-arguments]
responses-stream *prompt:
    #!/usr/bin/env -S bash -Eeuo pipefail
    {
        [[ -z "$*" ]] || echo "$*"
        [[ -t 0    ]] || cat
    } | "$this" responses-streamed-request \
        | grep --line-buffered -Po '^data: \K.+' \
        | while read -r line; do
            jq -rj 'if .type == "response.output_text.delta" then .delta else empty end' <<< "$line"
        done

# Ask the model to produce a unified diff via the apply_patch custom tool and print it
[group('responses'), positional-arguments]
patch *prompt:
    #!/usr/bin/env -S bash -Eeuo pipefail
    input="$*"
    [[ -t 0 ]] || input+=$'\n'"$(cat)"
    jq -ncS '{model: $model, instructions: $instructions, input: $input, tools: [{type: "custom", name: "apply_patch"}]}' \
            --arg model "$DEEPSEEK_MODEL" \
            --rawfile instructions <("$this" patch-instructions) \
            --arg input "$input" \
        | "$this" http-request-cached POST "/responses" \
        | jq -r '.output[] | select(.type == "custom_tool_call") | .input'

# Apply a unified diff provided via STDIN. Uses git apply unless DEEPSEEK_APPLY_PATCH_CMD points to another tool
[group('responses')]
apply-patch:
    #!/usr/bin/env -S bash -Eeuo pipefail
    if [[ -n "${DEEPSEEK_APPLY_PATCH_CMD:-}" ]]; then
        exec "$DEEPSEEK_APPLY_PATCH_CMD"
    fi
    command -v git >/dev/null 2>&1 || "$this" common::fatal "git is required to apply unified diffs.
        Install git or point DEEPSEEK_APPLY_PATCH_CMD to a compatible patch command"
    read -r -a args <<< "${DEEPSEEK_GIT_APPLY_ARGS:---whitespace=nowarn}"
    exec git apply "${args[@]}" -

# Edit a single file in one shot: the model returns a unified diff and git apply applies it
[group('responses'), positional-arguments]
edit-patch path *prompt:
    #!/usr/bin/env -S bash -Eeuo pipefail
    [[ -f "$path" ]] || "$this" common::fatal "not a file: $path"
    input=$(jq -rn --rawfile c "$path" --arg p "$path" --arg req "$*" '
        "Edit the file at \($p).\n\nRequest: \($req)\n\nCurrent content:\n```\n\($c)\n```"
    ')
    patch=$(
        jq -ncS '{model: $model, instructions: $instructions, input: $input, tools: [{type: "custom", name: "apply_patch"}]}' \
                --arg model "$DEEPSEEK_MODEL" \
                --rawfile instructions <("$this" patch-instructions) \
                --arg input "$input" \
            | "$this" http-request-cached POST "/responses" \
            | jq -r '.output[] | select(.type == "custom_tool_call") | .input'
    )
    [[ -n "$patch" ]] || "$this" common::fatal "model did not return a patch for: $path"
    printf '%s\n' "$patch" | "$this" apply-patch

