        "$this" http::request "$method" "$uri"
        --no-ignore-stdin
        --auth-type=bearer
        --auth="$("$this" api-key)"
        "$@"
    )
    payload="$(cat)"
    memoize -l "$(md5sum <<< "$payload")" -- "${cmd[@]}" <<< "$payload"

