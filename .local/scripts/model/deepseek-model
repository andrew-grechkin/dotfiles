# => helper ------------------------------------------------------------------------------------------------------- {{{1

# Print thinking mode config fragment. type is enabled/disabled, effort defaults to DEEPSEEK_REASONING_EFFORT
[group('helper'), private]
reasoning type='enabled' effort='':
    #!/usr/bin/env -S bash -Eeuo pipefail
    [[ -n "$effort" ]] || effort="$DEEPSEEK_REASONING_EFFORT"
    jq -ncS '{thinking: {type: $t}} + (if $t == "enabled" then {reasoning_effort: $e} else {} end)' \
        --arg t "$type" --arg e "$effort"

# Print stop config fragment from DEEPSEEK_STOP (newline separated sequences)
[group('helper'), private]
stop-config:
    #!/usr/bin/env -S bash -Eeuo pipefail
    if [[ -n "${DEEPSEEK_STOP:-}" ]]; then
        jq -ncS '{stop: ($s | split("\n"))}' --arg s "$DEEPSEEK_STOP"
    else
        echo '{}'
    fi

# Build content items (text descriptor plus image part) for the provided path. DeepSeek vision accepts images only
[group('helper'), private]
file-content path:
    #!/usr/bin/env -S bash -Eeuo pipefail
    mime="$(file -b --mime-type "$path")"
    size="$(wc -c < "$path")"
    if [[ "$mime" == image/* ]]; then
        jq -ncS --rawfile d <(base64 -w0 "$path") --arg m "$mime" --arg p "$path" --arg s "$size" '
            [
                {"type": "text", "text": ("this is a file (path: " + $p + ", size in bytes: " + $s + ")")},
                {"type": "image_url", "image_url": {"url": ("data:" + $m + ";base64," + $d)}}
            ]'
    else
        "$this" common::fatal "deepseek accepts image files only for vision, got [$mime]: $path"
    fi

# Print default instructions
