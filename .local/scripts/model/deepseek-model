# Send request with data already prepared as a valid chat-completions body via STDIN
[group('text'), private]
prepared-request:
    #!/usr/bin/env -S bash -Eeu
    jq -ncS --slurpfile req <(cat) --argjson instructions "$("$this" default-instructions)" --arg model "$DEEPSEEK_MODEL" '
        ($req[0] + {model: ($req[0].model // $model)}) as $r
        | $r + {messages: ([$instructions] + ($r.messages // []))}
    ' | "$this" http-request-cached POST "/chat/completions"

# Send request with raw text data and streaming response
[group('http'), private]
streamed-request:
    #!/usr/bin/env -S bash -Eeu
    jq -ncS '{model: $model, messages: ([$instructions] + [{"role": "user", "content": $prompt}]), stream: true} + $reasoning[0]' \
            --arg model "$DEEPSEEK_MODEL" \
            --argjson instructions "$("$this" default-instructions)" \
            --rawfile prompt <(cat) \
            --slurpfile reasoning <("$this" reasoning) \
        | "$this" http-stream POST "/chat/completions"

# Send request with raw text data
[group('http'), private]
raw-request:
    #!/usr/bin/env -S bash -Eeu
    jq -ncS '{model: $model, messages: ([$instructions] + [{"role": "user", "content": $prompt}])} + $reasoning[0]' \
            --arg model "$DEEPSEEK_MODEL" \
            --argjson instructions "$("$this" default-instructions)" \
            --rawfile prompt <(cat) \
            --slurpfile reasoning <("$this" reasoning) \
        | "$this" http-request-cached POST "/chat/completions"

# Build and send a Responses API request from raw text provided via STDIN
[group('responses'), private]
responses-request:
    #!/usr/bin/env -S bash -Eeu
    jq -ncS --rawfile input <(cat) --argjson sys "$("$this" default-instructions)" --arg model "$DEEPSEEK_MODEL" '
        {model: $model, instructions: $sys.content, input: $input}
    ' | "$this" http-request-cached POST "/responses"

