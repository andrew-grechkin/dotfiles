# Show log events formatted as YAML (query in STDIN)
[group('logs'), positional-arguments]
analyze namespace *argv:
    #!/usr/bin/env -S bash -Eeuo pipefail
    shift 1
    "$this" query "$namespace" "$@" | jq -c '.[]' | json2yaml | FORMAT_YAML_MODE=full format-yaml | colored-yaml

# Show raw logs without metadata (query in STDIN)
[group('logs'), positional-arguments]
logs namespace *argv:
    #!/usr/bin/env -S bash -Eeuo pipefail
    shift 1
    echo -e "time\tline"
    "$this" query "$namespace" "$@" | jq -r '.[] | .time + "\t" + .line'

# Show tail raw logs, streaming until Ctrl-C (query in STDIN, LOKI_QUERY, or `query==...`)
[group('logs'), positional-arguments, no-exit-message]
tail namespace *argv:
    #!/usr/bin/env perl
    # Implemented with Mojo because xh doesn't support ws and support in curl is not proper
    # Streams Loki's /loki/api/v1/tail (WebSocket) via Mojo. Extra args are `key==value`
    # xh-style URL params (limit==N, delay_for==N, start==<ns>, ...). Outputs one log line
    # per row, matching logcli's `--output raw` behavior.
    use v5.36;
    use warnings     qw(FATAL utf8);
    use experimental qw(builtin declared_refs defer for_list refaliasing try);

    use English qw(-no_match_vars);

    BEGIN {
        ## no critic [Variables::RequireLocalizedPunctuationVars]
        $ENV{MOJO_LOG_LEVEL} //= 'error';
    }

    use Mojo::JSON      qw(decode_json);
    use Mojo::Promise   qw();
    use Mojo::URL       qw();
    use Mojo::UserAgent qw();

    local $OUTPUT_AUTOFLUSH = 1;
    STDERR->autoflush(1);

    my ($namespace, @argv) = @ARGV;
    die "usage: tail <namespace> [key==value ...]\n" unless defined $namespace;

    # Build URL params: defaults + CLI `key==value` overrides
    my %params = (limit => 100, delay_for => 0);
    for my $a (@argv) {
        $params{$1} = $2 if $a =~ /^([^=]+)==(.*)$/;
    }

    # Resolve query if not provided via CLI: LOKI_QUERY > STDIN.
    # If STDIN is a TTY, print the same hint as the other recipes so the user can
    # type the query and finish with Ctrl-D.
    if (!defined $params{query}) {
        if (defined $ENV{LOKI_QUERY}) {
            $params{query} = $ENV{LOKI_QUERY};
        } else {
            say {*STDERR} "query must be provided via STDIN" if -t 0;
            my $q = do { local $/; <STDIN> };
            say {*STDERR} "" if -t 0;
            chomp $q if defined $q;
            $params{query} = $q if defined $q && length $q;
        }
    }

    die "query must be provided via STDIN, LOKI_QUERY, or `query==...` on the CLI\n"
        unless defined $params{query} && length $params{query};

    chomp(my $token = qx{credp sso.prod.$ENV{DOMAIN}.com});
    die "failed to fetch credp token\n" unless length $token;

    my $url = Mojo::URL->new("wss://loki.$ENV{DOMAIN}.com/loki/api/v1/tail");
    $url->query(\%params);

    my $ua = Mojo::UserAgent->new;
    $ua->inactivity_timeout(0);
    $ua->request_timeout(0);

    my $done = Mojo::Promise->new;
    local $SIG{INT} = local $SIG{TERM} = sub { $done->resolve };

    $ua->websocket_p($url => {
        "x-scope-orgid"                   => $namespace,
        "x-$ENV{DOMAIN}-iam-access-token" => $token,
    })->then(sub ($tx) {
        $tx->on(text => sub ($tx, $msg) {
            try {
                my $data = decode_json($msg);
                return unless ref $data eq 'HASH';
                for my $stream (@{ $data->{streams} // [] }) {
                    for my $v (@{ $stream->{values} // [] }) {
                        say $v->[1];   # log line only, matches logcli `--output raw`
                    }
                }
            } catch ($e) {
                # malformed JSON frame - skip silently, keep streaming
            }
        });
        $tx->on(finish => sub ($tx, $code = 1000, $reason = '') {
            say {*STDERR} "closed: $code $reason" if $code && $code != 1000;
            $done->resolve;
        });
    })->catch(sub ($err) {
        say {*STDERR} "websocket error: $err";
        $done->resolve;
    });

    $done->wait;

# Show raw unfiltered logs bucketed by pod name
[group('logs'), positional-arguments]
logs-by-pod namespace service *argv:
    #!/usr/bin/env -S bash -Eeuo pipefail
    shift 2

    {
        echo $'pod\ttime\tline'
        query='{ {{DOMAIN}}_service="{{service}}", k8s_container_name=~"{{K8S_CONTAINER_NAME}}|"}'
        unset LOKI_QUERY
        "$this" query "$namespace" "$@" <<< "$query" \
            | jq -r --arg bucket "k8s_pod_name" --arg odd $'\e[36m' --arg even $'\e[96m' --arg normal $'\e[0m' '
                group_by(.labels[$bucket])
                | to_entries[]
                | (if .key % 2 == 0 then $odd else $even end) as $color
                | .value[]
                | $color + "\(.labels[$bucket])\($normal)\t\(.time)\t\(.line)"
            '
    } | if [[ -t 1 && -x "$(command -v json2tsv)" && -x "$(command -v tsv-show)" ]]; then
        tsv-show
    else
        cat
    fi

