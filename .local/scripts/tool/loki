# Print help
[group('doc'), no-exit-message]
help:
    #!/usr/bin/env -S colored-md

    # ABSTRACT

    Wrapper around grafana loki

    # DESCRIPTION

    Just better version than official loki CLI

    # ENVIRONMENT

    - `DOMAIN`: REQUIRED, e.g. `my_company`. Selects the Loki endpoint and auth.
    - `LOKI_QUERY`: optional LogQL query. When set, used instead of STDIN.
    - `LOKI_PRUNE`: jq filter applied to raw stream entries. Default drops dedup metadata; set to `.` to keep everything.
    - `LOKI_PARSE_JSON`: when set (any value), attempt to parse each log line as JSON into `__parsed_line__` field.
    - `K8S_CONTAINER_NAME`: default container filter for `logs-by-pod` (defaults to `app`).

    # SYNOPSIS

    ```
    # LOG VIEWERS - same query, different output shape:
    #   query         -> JSON, folded (common labels deduped)      pipe to jq/scripts
    #   logs          -> tab-separated time+line                   quick eyeball
    #   analyze       -> YAML per event                            deep inspection
    #   logs-by-pod   -> tab-separated grouped by pod (colored)    multi-pod diagnostics
    #   tail          -> streaming via logcli until Ctrl-C         live tailing

    # discovery: what labels exist in this tenant? (all label NAMES)
    loki labels deployments

    # discovery: what values does a label take? (values of one label)
    loki labels deployments/service_name

    # discovery: for a given query, what fields could I filter on? (labels + their cardinality)
    loki detect deployments <<< '{service_name="api"}'

    # discovery: which labels are shared across ALL results of this query? (get stripped from `query` output)
    loki common-labels deployments <<< '{service_name="api"}'

    # basic search (which lines mention "feature-flags"?)
    loki logs deployments <<< '{service_name="api"} |= "feature-flags"'

    # structured filter after parsing JSON logs (which lines have level=ERROR?)
    loki query deployments <<< '{service_name="api"} | json | level="ERROR"'

    # multi-line query via heredoc
    loki query deployments << 'LOGQL'
    {service_name="api", k8s_container_name="app"}
      | json | level="ERROR" | duration_ms > 100
    LOGQL

    # auto-parse each log line as JSON so downstream jq can dot-access fields
    LOKI_PARSE_JSON=1 loki query deployments <<< '{service_name="api"}'

    # reuse the same LogQL across invocations without stdin
    LOKI_QUERY='{service_name="api"} |= "ERROR"' loki logs deployments

    # YAML view (one YAML document per event; easier to eyeball structured logs)
    loki analyze deployments <<< '{service_name="api"} | json'

    # multi-pod diagnostics (group lines by pod with alternating colors)
    loki logs-by-pod deployments api

    # live tail (Ctrl-C to stop; passes through to logcli)
    loki tail deployments <<< '{service_name="api"} |= "ERROR"'

    # CLI-arg overrides - Loki accepts these as `key==value` xh query params:
    #   since==5m         lookback duration (Loki alternative to start/end)
    #   limit==500        max lines returned (default 100)
    #   direction==forward   or backward (default: backward)
    loki query deployments since==5m limit==500 <<< '{service_name="api"}'

    # untouched JSON from /query_range (for scripting; skips fold/prune)
    loki raw-query deployments <<< '{service_name="api"}' | jq '.data.result[0].values'

    # direct request to any Loki endpoint (escape hatch when no recipe fits)
    loki http-request deployments GET /labels

    # clickable doc links (LogQL, HTTP API, best practices)
    loki doc

    # printed LogQL cheatsheet (no browser, works over SSH)
    loki cheatsheet
    ```

