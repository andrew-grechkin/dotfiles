# => verify ------------------------------------------------------------------------------------------------------- {{{1

# A/B compare Graphite target vs PromQL
[group('verify'), positional-arguments]
ab namespace *argv:
    #!/usr/bin/env -S bash -Eeuo pipefail
    shift 1

    input=$(</dev/stdin)
    graphite_query=$(printf '%s\n' "$input" | perl -ne 'exit if /^---$/; print')
    promql=$(printf '%s\n' "$input" | perl -ne 'if (/^---$/) { $div = 1; next } print if $div')

    if [[ -z "$graphite_query" || -z "$promql" ]]; then
        echo "usage: mimir ab <namespace> <<< '<graphite>\\n---\\n<promql>'" >&2
        exit 2
    fi

    graphite_bin="$(dirname "$this")/graphite"
    if [[ ! -x "$graphite_bin" ]]; then
        echo "graphite tool not found next to mimir tool ($graphite_bin)" >&2
        exit 2
    fi

    gv=$("$graphite_bin" query <<< "$graphite_query"\
        | jq -r '.[]? | [.datapoints[] | select(.[0]!=null) | .[0]][-1] // empty' | head -1)

    mv=$("$this" raw-query "$namespace" <<< "$promql" | jq -r '.data.result[0].value[1] // empty')

    gv="${gv:-n/a}"
    mv="${mv:-n/a}"

    printf '%-10s %s\n' 'graphite:' "$gv"
    printf '%-10s %s\n' 'mimir:' "$mv"

    if [[ "$gv" != "n/a" && "$mv" != "n/a" ]]; then
        perl -e '
            my ($g, $m) = @ARGV;
            if ($g + 0 == 0 && $m + 0 == 0) { print "OK (both zero)\n"; exit 0 }
            my $diff = abs($g - $m);
            my $max  = $g > $m ? $g : $m;
            my $pct  = $max == 0 ? 0 : $diff / $max * 100;
            printf("diff:      %.2f%% %s\n", $pct, ($pct > 10 ? "WARN >10%" : "OK"));
        ' "$gv" "$mv"
    fi

# => lsp ---------------------------------------------------------------------------------------------------------- {{{1

# Private helper: header-injecting HTTP proxy for the PromQL language server
[private, positional-arguments, no-exit-message]
_lsp-proxy port upstream tenant:
    #!/usr/bin/env perl
    # Proxies 127.0.0.1:<port> -> <upstream>, injecting `x-scope-orgid: <tenant>` on every request.
    # Port `0` self-allocates; the chosen port is printed on stdout as a single line for the parent.
    # Patches `/api/v1/status/buildinfo` (Mimir returns "" for version which promql-langserver rejects);
    # stub is overridable via `MIMIR_LSP_VERSION_STUB`. `MOJO_LOG_LEVEL` defaults to `error`.
    use v5.36;
    use warnings     qw(FATAL utf8);
    use experimental qw(builtin declared_refs defer for_list refaliasing try);

    use English qw(-no_match_vars);

    BEGIN {
        ## no critic [Variables::RequireLocalizedPunctuationVars]
        $ENV{MOJO_LOG_LEVEL} //= 'error';
    }

    use Mojo::IOLoop         qw();
    use Mojo::JSON           qw(decode_json encode_json);
    use Mojo::Server::Daemon qw();
    use Mojo::URL            qw();
    use Mojo::UserAgent      qw();

    use constant {
        'STATUS_BAD_GATEWAY' => 502,
        'UPSTREAM_TIMEOUT'   => 15,
    };

    my %HOP_BY_HOP = map { $_ => 1 } qw(
        connection keep-alive proxy-authenticate proxy-authorization
        te trailer trailers transfer-encoding upgrade
    );
    my %REQ_STRIP = (%HOP_BY_HOP, host             => 1);
    my %RES_STRIP = (%HOP_BY_HOP, 'content-length' => 1);

    local $OUTPUT_AUTOFLUSH = 1;
    STDERR->autoflush(1);

    my ($listen_port, $upstream_url, $tenant) = @ARGV;
    die "usage: _lsp-proxy <port|0> <upstream> <tenant>\n"
        unless defined $listen_port && defined $upstream_url && defined $tenant;
    $upstream_url =~ s{/+ $}{}x;

    my $version_stub = $ENV{MIMIR_LSP_VERSION_STUB} // '2.55.0';

    sub patch_buildinfo ($content, $stub) {
        my $data;
        try {
            $data = decode_json($content);
        } catch ($e) {
            return $content;
        }
        return $content if ref $data ne 'HASH';
        return $content if (($data->{data}{version} // '') ne '');
        $data->{data}{version} = $stub;
        return encode_json($data);
    }

    my $ua = Mojo::UserAgent->new;
    $ua->max_response_size(0);
    $ua->request_timeout(UPSTREAM_TIMEOUT());

    my $daemon = Mojo::Server::Daemon->new(
        listen => ["http://127.0.0.1:$listen_port"],
        silent => 1,
    );

    $daemon->unsubscribe('request')->on(
        request => sub ($daemon, $tx) {
            my $req    = $tx->req;
            my $target = Mojo::URL->new($upstream_url . $req->url->path_query);

            my $utx = $ua->build_tx($req->method => $target);
            $utx->req->headers->from_hash($req->headers->to_hash);
            $utx->req->headers->remove($_) for keys %REQ_STRIP;
            $utx->req->headers->header('x-scope-orgid' => $tenant);

            my $body = $req->body;
            $utx->req->body($body) if defined $body && length $body;

            $ua->start(
                $utx => sub ($ua, $utx) {
                    my $ures = $utx->res;

                    if (!$ures->code) {
                        my $err = $utx->error;
                        $tx->res->code(STATUS_BAD_GATEWAY());
                        $tx->res->body($err->{message} // 'upstream error');
                        return $tx->resume;
                    }

                    my $content = $ures->body // '';
                    if ($req->url->path =~ m{^ /api/v1/status/buildinfo }x) {
                        $content = patch_buildinfo($content, $version_stub);
                    }

                    $tx->res->code($ures->code);
                    for my $name ($ures->headers->names->@*) {
                        next if $RES_STRIP{lc $name};
                        $tx->res->headers->header($name => $ures->headers->header($name));
                    }
                    $tx->res->body($content);
                    $tx->res->headers->content_length(length $content);
                    $tx->resume;
                },
            );
        },
    );

    $daemon->start;
    my $bound_port = Mojo::IOLoop->acceptor($daemon->acceptors->[0])->port;
    say $bound_port;
    say {*STDERR} "mimir lsp proxy on 127.0.0.1:$bound_port -> $upstream_url (tenant=$tenant)";
    $daemon->ioloop->start;

# https://github.com/prometheus-community/promql-langserver
# PromQL language server on stdio
[group('lsp'), positional-arguments, no-exit-message]
lsp namespace:
    #!/usr/bin/env -S bash -Eeuo pipefail

    if ! command -v promql-langserver >/dev/null; then
        cat >&2 <<'EO_HELP'
    promql-langserver not found in PATH. Install with:
        go install github.com/prometheus-community/promql-langserver/cmd/promql-langserver@latest

    Note: the upstream repo is archived; consult forks if it stops building
    EO_HELP
        exit 127
    fi

    # Proxy self-allocates its port and announces it on stdout as the first line;
    # coproc lets us read that line while the proxy keeps running in the background.
    # `setsid` puts `just` + its perl child into their own process group so we can
    # signal the whole tree with a single group kill (`kill -- -$pgid`)
    coproc PROXY { exec setsid "$this" _lsp-proxy 0 "https://mimir.$DOMAIN.com/prometheus" "$namespace"; }
    proxy_pid=$PROXY_PID
    trap "kill -TERM -- -$proxy_pid 2>/dev/null || true" EXIT

    read -r port <&"${PROXY[0]}"
    [[ "$port" =~ ^[0-9]+$ ]] || { echo "proxy failed to report a port: '$port'" >&2; exit 1; }

    # Coproc fds are CLOEXEC in bash, so `promql-langserver` won't inherit them; no explicit close needed.
    promql-langserver -config-file <(printf 'prometheus_url: http://127.0.0.1:%s\n' "$port")

