# Print help
[group('doc'), no-exit-message]
help:
    #!/usr/bin/env -S colored-md

    # ABSTRACT

    Wrapper around grafana mimir (prometheus-compatible API). Read-only
    endpoints on `mimir.$DOMAIN.com` are anonymous; no auth is sent.

    # ENVIRONMENT

    - `DOMAIN`: REQUIRED, e.g. `my-company`. Selects the mimir endpoint.
    - `MIMIR_QUERY`: optional PromQL / matcher. When set, used instead of STDIN.
    - `MIMIR_START` / `MIMIR_STEP`: for `find-series` and `query-range` (unix seconds; step in seconds or duration
        string).
    - `MIMIR_RANGE`: duration string (`1h`, `2d`, `30m`, `1w`) - lookback from now; alternative to `MIMIR_START`. If
        both are set, `MIMIR_START` wins.
    - `MIMIR_LIMIT`: top-N cutoff for `cardinality` (default 20; Mimir's cardinality API caps at 500).

    # SYNOPSIS

    ```
    # THE QUERY TRIO - pick by what you need to know:
    #   query        -> ONE value per series, evaluated at "now"       (snapshot)
    #   query-range  -> MANY values per series, evaluated at each step (evolution over time)
    #   find-series  -> LABEL SETS ONLY, no values                     (which series exist? cheap existence probe)

    # instant query (what does this PromQL currently return? one value per matching series)
    mimir query dlb <<< 'up{job="haproxy"}'

    # raw JSON (unfolded) - use in scripts that need `.data.result[0].value[1]` etc
    mimir raw-query dlb <<< 'up{job="haproxy"}'

    # list every label name in the tenant (what dimensions can I filter series by?)
    mimir labels dlb

    # values of a specific label (which HAProxy backends does dlb know about?)
    mimir labels dlb/proxy | grep artifactory

    # range query - PromQL evaluated at each step across a window (how did this evolve over the last 1h?)
    mimir query-range dlb <<< 'sum(rate(haproxy_backend_http_responses_total{role="artifactory", code="4xx"}[5m]))'

    # bare selector into query-range = per-series evolution (each matching series, with samples)
    mimir query-range dlb <<< 'haproxy_backend_active_servers{role="artifactory"}'

    # override range window (unix seconds) and step
    MIMIR_START=$(( $(date +%s) - 7200 )) MIMIR_STEP=30 mimir query-range dlb <<< 'up'

    # same but with a duration string instead of computing epochs
    MIMIR_RANGE=2h MIMIR_STEP=30 mimir query-range dlb <<< 'up'

    # or pass overrides as CLI args (xh `key==value` for query params - `start`, `end`, `step`, `limit`, ...)
    mimir query-range dlb start==1700000000 end==1700086400 step==30 <<< 'up'
    mimir find-series dlb start==1700000000 <<< 'up'

    # /series probe - LABEL SETS ONLY, no sample values (does this label combo exist? cheap; 24h lookback)
    mimir find-series dlb <<< 'haproxy_backend_active_servers{role="b-sonarqube-sonarqube-dce"}'

    # extend the historical window to 30 days
    MIMIR_RANGE=30d mimir find-series dlb <<< '<matcher>'

    # all metrics enriched with metadata (what metrics exist and what do they mean?)
    mimir metrics dlb

    # metadata for one metric (what is the TYPE and HELP for this specific metric?)
    mimir metrics dlb haproxy_backend_active_servers

    # Perl-style regex filter (which metrics match this pattern?  case-insens. via `i`, etc.)
    mimir metrics dlb 'm/^haproxy_backend_/'
    mimir metrics dlb 'm/up/i'

    # just the names, if that is what you want
    mimir metrics dlb | jq -r '.[].name'

    # find-metrics - same filter, plain-text output (which metric names match? handy for pipes)
    mimir find-metrics dlb 'm/haproxy/'

    # values a label takes for series matching a matcher (which `role`s emit this metric?)
    mimir label-values dlb/role <<< 'haproxy_backend_active_servers'

    # cardinality digest (which labels have the most values? which metrics have the most series?)
    mimir cardinality dlb
    MIMIR_LIMIT=50 mimir cardinality dlb

    # recording/alerting rules (what rules run in this tenant?  which mention `artifactory`?)
    mimir rules dlb
    mimir rules dlb 'm/artifactory/i'

    # raw variants when you need untouched JSON
    mimir raw-query dlb <<< '<promql>'
    mimir raw-query-range dlb <<< '<promql>'
    mimir raw-series dlb <<< '<matcher>'

    # A/B compare Graphite vs PromQL (does the translated PromQL match the original Graphite number?)
    mimir ab dlb <<AB
    groupByNode(loadbalancers.group.*.*.haproxy.role.artifactory.backend.artifactory_$DOMAIN_com_https_all.act,6, 'avg')
    ---
    avg(haproxy_backend_active_servers{role="artifactory", proxy="artifactory.$DOMAIN.com_https_all"})
    AB

    # direct request to any endpoint (escape hatch when no recipe covers the endpoint you need)
    # xh syntax: `key:value` = header, `key==value` = query param
    mimir http-request GET /label/__name__/values x-scope-orgid:dlb
    mimir http-request GET /cardinality/label_names x-scope-orgid:dlb limit==10

    # clickable doc links (Prometheus, Mimir, PromLabs) - jump to reference in the browser
    mimir doc

    # printed PromQL cheatsheet (fast, no browser, works over SSH)
    mimir cheatsheet
    ```

