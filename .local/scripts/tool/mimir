# https://grafana.com/docs/mimir/latest/references/http-api/#label-names-cardinality
# https://grafana.com/docs/mimir/latest/references/http-api/#label-values-cardinality
# Top labels and metrics by cardinality
[group('overview')]
cardinality namespace:
    #!/usr/bin/env -S bash -Eeuo pipefail
    # Prometheus' `/status/tsdb` is 404 on Mimir; these Mimir-native endpoints replace it.
    # `MIMIR_LIMIT` overrides top-N (default 20).
    limit="${MIMIR_LIMIT:-20}"
    labels=$( "$this" http-request GET /cardinality/label_names  "x-scope-orgid:$namespace" "limit==$limit")
    metrics=$("$this" http-request GET /cardinality/label_values "x-scope-orgid:$namespace" "limit==$limit" "label_names[]==__name__")
    jq -n --argjson l "$labels" --argjson m "$metrics" '{
        totals: {
            label_names:  $l.label_names_count,
            label_values: $l.label_values_count_total,
            series:       $m.series_count_total,
        },
        top_labels_by_value_count:   ($l.cardinality // []),
        top_metrics_by_series_count: (($m.labels // [])[0].cardinality // []),
    }'

# Raw metric names with optional filter
[group('overview'), positional-arguments]
find-metrics namespace *argv:
    #!/usr/bin/env -S bash -Eeuo pipefail
    shift 1

    while read -r line; do
        [[ "$line" =~ ^mimir_arg_[a-z]+= ]] && declare -g -- "$line"
    done < <("$this" _match-parse "${1:-}")

    "$this" labels "$namespace/__name__" | jq -r \
        --arg mode "$mimir_arg_mode" --arg p "$mimir_arg_pattern" --arg fl "$mimir_arg_flags" '
        .data[] | select(
            $mode == "all"
            or ($mode == "exact" and . == $p)
            or ($mode == "re"    and test($p; $fl))
        )
    '

# Label sets by matcher (no values)
[group('overview'), positional-arguments]
find-series namespace *argv:
    #!/usr/bin/env -S bash -Eeuo pipefail
    "$this" raw-series "$@" \
        | jq '[.data[] | {metric: .}]' \
        | "$this" _fold-common \
        | json2yaml | colored-yaml

# List all scraper jobs for a tenant
[group('overview')]
jobs namespace: (labels f'{{namespace}}/job')

# https://prometheus.io/docs/prometheus/latest/querying/api/#querying-label-values
# Label values scoped by a matcher
[group('overview'), positional-arguments]
label-values namespace_label *argv:
    #!/usr/bin/env -S bash -Eeuo pipefail
    shift 1

    if [[ "$namespace_label" != */* ]]; then
        echo "usage: mimir label-values <namespace>/<label> <<< '<matcher>'" >&2
        exit 2
    fi
    IFS='/' read -r namespace label <<< "$namespace_label"

    args=(
        GET "/label/$label/values"
        "x-scope-orgid:$namespace"
    )

    if [[ -n "${MIMIR_QUERY:-}" ]]; then
        args+=("match[]==$MIMIR_QUERY")
    else
        [[ -t 0 ]] && echo "matcher must be provided via STDIN" >&2
        args+=("match[]==$(</dev/stdin)")
        echo >&2
    fi

    "$this" http-request "${args[@]}" "$@"

# https://prometheus.io/docs/prometheus/latest/querying/api/#getting-label-names
# https://prometheus.io/docs/prometheus/latest/querying/api/#querying-label-values
# List label names, or values of a label
[group('overview'), positional-arguments]
labels namespace_label *argv:
    #!/usr/bin/env -S bash -Eeuo pipefail
    shift 1

    if [[ "$namespace_label" == */* ]]; then
        IFS='/' read -r namespace label <<< "$namespace_label"
        "$this" http-request GET "/label/$label/values" "x-scope-orgid:$namespace" "$@"
    else
        "$this" http-request GET "/labels" "x-scope-orgid:$namespace_label" "$@"
    fi

# Metrics with metadata; optional filter
[group('overview'), positional-arguments]
metrics namespace *argv:
    #!/usr/bin/env -S bash -Eeuo pipefail
    # Combines /label/__name__/values (all names) with /metadata (documented names) via a left-outer join.
    shift 1

    while read -r line; do
        [[ "$line" =~ ^mimir_arg_[a-z]+= ]] && declare -g -- "$line"
    done < <("$this" _match-parse "${1:-}")

    names=$("$this" http-request GET /label/__name__/values "x-scope-orgid:$namespace")
    meta=$("$this"  http-request GET /metadata              "x-scope-orgid:$namespace")
    jq -n --argjson n "$names" --argjson m "$meta" \
          --arg mode "$mimir_arg_mode" --arg p "$mimir_arg_pattern" --arg fl "$mimir_arg_flags" '
        ($m.data // {}) as $md
        | $n.data
        | map(select(
            $mode == "all"
            or ($mode == "exact" and . == $p)
            or ($mode == "re"    and test($p; $fl))
          ))
        | sort
        | map(
            {name: ., type: $md[.][0].type, help: $md[.][0].help, unit: $md[.][0].unit}
            | with_entries(select(.value != null and .value != ""))
          )
    '

# https://prometheus.io/docs/prometheus/latest/querying/api/#rules
# List recording/alerting rules
[group('overview'), positional-arguments]
rules namespace *argv:
    #!/usr/bin/env -S bash -Eeuo pipefail
    shift 1

    while read -r line; do
        [[ "$line" =~ ^mimir_arg_[a-z]+= ]] && declare -g -- "$line"
    done < <("$this" _match-parse "${1:-}")

    "$this" http-request GET /rules "x-scope-orgid:$namespace" | jq \
        --arg mode "$mimir_arg_mode" --arg p "$mimir_arg_pattern" --arg fl "$mimir_arg_flags" '
        [.data.groups[]?.rules[]?
         | select(
             $mode == "all"
             or ($mode == "exact" and .name == $p)
             or ($mode == "re"    and (.name | test($p; $fl)))
           )
         | {type, name, query, health, labels}]
    '

# => query -------------------------------------------------------------------------------------------------------- {{{1

# Private helper: parse a name-filter arg into three declare-safe lines
[private, positional-arguments]
_match-parse filter:
    #!/usr/bin/env -S bash -Eeuo pipefail
    # Emits `mimir_arg_mode`, `mimir_arg_pattern`, `mimir_arg_flags` for callers to
    # consume via the declare-loop pattern. Filter grammar: empty -> all;
    # `m/pattern/flags` -> regex (Perl-style, last `/` is delimiter); else -> exact.
    if   [[ -z "$1"                     ]]; then printf 'mimir_arg_mode=all\nmimir_arg_pattern=\nmimir_arg_flags=\n'
    elif [[ "$1" =~ ^m/(.*)/([a-z]*)$   ]]; then printf 'mimir_arg_mode=re\nmimir_arg_pattern=%s\nmimir_arg_flags=%s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
    else                                         printf 'mimir_arg_mode=exact\nmimir_arg_pattern=%s\nmimir_arg_flags=\n'  "$1"
    fi

# Private helper: convert a duration string to seconds. Accepts `\d+[smhdw]` or a bare integer.
[private, positional-arguments]
_secs value:
    #!/usr/bin/env perl
    my $v = $ARGV[0];
    my %m = (s => 1, m => 60, h => 3600, d => 86400, w => 604800);
    if    ($v =~ /^(\d+)([smhdw])$/) { print $1 * $m{$2} }
    elsif ($v =~ /^\d+$/)            { print $v }
    else { die "invalid duration: $v (expected e.g. 3600, 1h, 2d)\n" }

# Private helper: fold labels common to every entry onto the last entry
[private]
_fold-common:
    #!/usr/bin/env -S bash -Eeuo pipefail
    # Reads array of `{metric: {...}, ...}` on stdin; outputs same shape with `.common` attached to last.
    jq '
        . as $r
        | ($r | length) as $n
        | ($r
           | if $n == 0 then {}
             else [.[].metric | to_entries[]]
                  | group_by([.key, .value])
                  | map(select(length == $n)[0])
                  | from_entries
             end) as $common
        | ($common | keys) as $ck
        | $r
        | map(.metric |= with_entries(select(.key | IN($ck[]) | not)))
        | if (length > 0 and ($common | length > 0))
          then .[-1].common_metric = $common
          else .
          end
    '

# Instant query with folded output
[group('query'), positional-arguments]
query namespace *argv:
    #!/usr/bin/env -S bash -Eeuo pipefail
    "$this" raw-query "$@" | jq '.data.result' | "$this" _fold-common

# Range query with folded output
[group('query'), positional-arguments]
query-range namespace *argv:
    #!/usr/bin/env -S bash -Eeuo pipefail
    "$this" raw-query-range "$@" | jq '.data.result' | "$this" _fold-common

# => raw-query ---------------------------------------------------------------------------------------------------- {{{1

# https://prometheus.io/docs/prometheus/latest/querying/api/#instant-queries
# Raw instant query
[group('raw-query'), positional-arguments]
raw-query namespace *argv:
    #!/usr/bin/env -S bash -Eeuo pipefail
    shift 1

    # NOTE: Prometheus (Go's net/url) uses the FIRST value on duplicate query params,
    # so need to explicitly skip default when the user supplied their own on the CLI (`key==val`)
    for a in "$@"; do case "$a" in "query=="*) have_query="1" ;; esac; done

    args=(GET "/query" "x-scope-orgid:$namespace")
    if [[ -z "${have_query:-}" ]]; then
        if [[ -n "${MIMIR_QUERY:-}" ]]; then
            args+=("query==$MIMIR_QUERY")
        else
            [[ -t 0 ]] && echo "query must be provided via STDIN" >&2
            args+=("query==$(</dev/stdin)")
            echo >&2
        fi
    fi

    "$this" http-request "${args[@]}" "$@"

# https://prometheus.io/docs/prometheus/latest/querying/api/#range-queries
# Raw range query
[group('raw-query'), positional-arguments]
raw-query-range namespace *argv:
    #!/usr/bin/env -S bash -Eeuo pipefail
    shift 1

    for a in "$@"; do case "$a" in
        "end=="*)   have_end="1" ;;
        "query=="*) have_query="1" ;;
        "start=="*) have_start="1" ;;
        "step=="*)  have_step="1" ;;
    esac; done

    now=$(date +%s)
    if   [[ -n "${MIMIR_START:-}" ]]; then start="$MIMIR_START"
    elif [[ -n "${MIMIR_RANGE:-}" ]]; then start="$((now - $("$this" _secs "$MIMIR_RANGE")))"
    else                                   start="$((now - 3600))"
    fi

    args=(GET "/query_range" "x-scope-orgid:$namespace")
    [[ -n "${have_end:-}" ]]   || args+=("end==$now")
    [[ -n "${have_start:-}" ]] || args+=("start==$start")
    [[ -n "${have_step:-}" ]]  || args+=("step==${MIMIR_STEP:-60}")

    if [[ -z "${have_query:-}" ]]; then
        if [[ -n "${MIMIR_QUERY:-}" ]]; then
            args+=("query==$MIMIR_QUERY")
        else
            [[ -t 0 ]] && echo "query must be provided via STDIN" >&2
            args+=("query==$(</dev/stdin)")
            echo >&2
        fi
    fi

    "$this" http-request "${args[@]}" "$@"

