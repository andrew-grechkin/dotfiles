# https://prometheus.io/docs/prometheus/latest/querying/api/
# Direct Prometheus API request
[group('http'), positional-arguments]
http-request method uri *argv:
    #!/usr/bin/env -S bash -Eeuo pipefail
    shift 2

    [[ "$uri" == /* ]] && uri="mimir.$DOMAIN.com$MIMIR_API${uri#${MIMIR_API}}"

    xh "$method" "$uri" "$@" --https --ignore-stdin
