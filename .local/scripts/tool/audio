[no-exit-message]
@list dir="/media/nfs/home/audio/music":
    memoize -t 1hour -- "$this" _list "$dir" \
        | just -f "$HOME/.local/lib/just/fzf" execute

[no-exit-message]
_list dir:
    #!/usr/bin/env -S bash -Eeuo pipefail

    {
        cd "$dir"
        while read -r line; do
            echo -e "${line}\tmpv --quiet --no-osc --term-osd=force --no-audio-display -- ${dir@Q}/${line@Q}"
        done < <(fd -t dir --min-depth 2 --max-depth 4 --relative-path)
    } | sort
