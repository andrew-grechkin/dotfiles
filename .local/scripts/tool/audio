#!/usr/bin/env -S just --one --justfile

# https://just.systems/man/en/

import "~/.local/lib/just/common"

set no-cd

export this := justfile()

[private]
@default:
    "$this" --list

show file:
    #!/usr/bin/env -S bash -Eeuo pipefail
    ffmpeg -y -loglevel error -i "$file" -map 0:v:0 -frames:v 1 -f image2pipe -vcodec png - 2>/dev/null \
        | chafa --clear -c full -f symbols --polite on 2>/dev/null || true
    echo "> mediainfo:"; mediainfo "$file" 2>&1
    echo "> ffmpeg:"; ffprobe -hide_banner -pretty "$file" 2>&1

edit-metadata file:
    #!/usr/bin/env -S bash -Eeuo pipefail
    if metadata=$("$this" fetch-metadata "$file"); then
        if res=$(vipe <<< "$metadata"); then
            "$this" update-metadata "$file" <<< "$res"
        fi
    fi

embed-art file:
    #!/usr/bin/env -S bash -Eeuo pipefail
    if [[ "$file" =~ [.]flac$ ]]; then
        mapfile -t files < <("$this" list-art)

        [[ "${#files[@]}" == "0" ]] && exit

        args=("--import-picture-from=${files[0]}")
        for ((i=1; i<${#files[@]}; i++)); do
            args+=("--import-picture-from=0||||${files[i]}")
        done

        metaflac "${args[@]}" "$file"
        rm -f -- "${files[@]}"
        find . -type d -empty -delete
        find . -type f -name '*.log' -delete
    fi

embed-cover cover file:
    #!/usr/bin/env -S bash -Eeuo pipefail
    if [[ "$file" =~ [.]flac$ ]]; then
        metaflac --import-picture-from="$cover" "$file"
    else
        ffmpeg -y -loglevel repeat+info -f image2 -pattern_type none -i "$cover" -update 1 -movflags +faststart file:"_tmp_cover.png"
        trap 'rm -f -- "_tmp_cover.png"' EXIT
        "$this" embed-thumbnail-flac "$file" "_tmp_cover.png"
    fi

embed-cue cue flac:
    #!/usr/bin/env -S bash -Eeuo pipefail
    # https://wiki.multimedia.cx/index.php/FFmpeg_Metadata
    # "title" "author" "album_artist" "composer" "album"
    # "year" "encoding_tool" "comment" "genre" "copyright"
    # "grouping" "lyrics" "description" "synopsis" "show"
    # "episode_id" "network" "keywords" "episode_sort"
    # "season_number" "media_type" "hd_video" "gapless_playback"
    # "compilation" "track"

    "$this" assert-encoding "$cue"
    bom remove "$cue"

    args=(
        --add-replay-gain
        --remove-tag=Comment
        --remove-tag=Date
        --remove-tag=Description
        --remove-tag=Genre
        --remove-tag=discid
        --remove-tag=tracktotal
        --remove-tag=cuesheet --set-tag-from-file="CUESHEET=$cue"
    )

    payload=$(cue2json "$cue")
    {
        read -r title
        read -r author
        read -r performer
        read -r composer
        read -r genre
        read -r message
    } < <(jq -r '.metadata | [.title, .songwriter, .performer, .composer, .genre, .message]|map(.//"")[]' <<< "$payload")

    # NOTE: I think FLAK title maps to album
    if [[ -n "$title" ]]; then
        regex="\[([[:digit:]]{4})\][[:space:]]*(.*)"
        if [[ "$title" =~ $regex ]]; then
            year="${BASH_REMATCH[1]}"
            args+=(--remove-tag=title --remove-tag=album --set-tag="album=${BASH_REMATCH[2]}")
        else
            args+=(--remove-tag=title --remove-tag=album --set-tag="album=$title")
        fi
    fi

    if [[ -z "$genre" ]]; then
        {
            read -r genre
        } < <(jq -r '.rem | [.genre]|map(.//"")[]' <<< "$payload")
    fi
    if [[ -z "${year:-}" ]]; then
        {
            read -r year
        } < <(jq -r '.rem | [.date]|map(.//"")[]' <<< "$payload")
    fi

    # NOTE: removing tag is always explicit because set-tag is case sensitive

    # NOTE: for some reason mpv expects artist tag, not author - doing both here to cover everything
    [[ -n "$author" ]]    && args+=(--remove-tag=artist --remove-tag=author --set-tag="artist=$author" --set-tag="author=$author")
    [[ -n "$composer" ]]  && args+=(--remove-tag=composer --set-tag="composer=$composer")
    [[ -n "$genre" ]]     && args+=(--remove-tag=genre --set-tag="genre=$genre")
    [[ -n "$message" ]]   && args+=(--remove-tag=description --set-tag="description=$message")
    [[ -n "$performer" ]] && args+=(--remove-tag=album_artist --set-tag="album_artist=$performer")
    [[ -n "$year" ]]      && args+=(--remove-tag=date --remove-tag=year --set-tag="year=$year")

    set -x
    metaflac "${args[@]}" "$flac"
    set +x
    rm -f -- "$cue"

[positional-arguments]
download url *argv:
    #!/usr/bin/env -S bash -Eeuo pipefail
    shift 1

    url=$("$this" prune-url <<< "$url")
    args=(
        --verbose
        --embed-chapters
        --embed-metadata
        --embed-thumbnail
        --format="ba[ext=m4a]"
        --no-config
        --no-simulate
        --output='%(fulltitle)s {id=%(id)s,up=%(uploader_id)s,ep=%(timestamp)s}.%(ext)s'
        # --prefer-free-formats
    )

    if [[ -t 1 ]]; then
        args+=(--list-formats)
    else
        args+=(--no-progress)
    fi

    umask 002
    tsp -q yt-dlp "${args[@]}" "$url" "$@"

# => mpv ---------------------------------------------------------------------------------------------------------- {{{1

play url:
    #!/usr/bin/env -S bash -Eeuo pipefail

    url=$("$this" prune-url <<< "$url")
    args=(
        --quiet
        --vid=no
        --ytdl-raw-options='format="ba/b"'
    )
    mpv "${args[@]}" -- "$url"

# => -------------------------------------------------------------------------------------------------------------- {{{1

[private, no-exit-message]
prune-url:
    #!/usr/bin/env -S perl
    use v5.42;
    use experimental qw(declared_refs refaliasing);
    use Mojo::URL    qw();

    my $input = <<>>;
    chomp $input;

    my $url = Mojo::URL->new($input);

    if (   $url->is_abs
        && defined $url->scheme
        && lc($url->scheme) eq 'https'
        && $url->host
        && $url->host =~ m/youtu[.]?be/)

    {
        $url->query($url->query->to_hash->%{v});
        say $url->to_string;
        exit 0;
    }

    say $input;

# fetch metadata of a file to STDOUT
[private, no-exit-message]
fetch-metadata file:
    #!/usr/bin/env -S bash -Eeuo pipefail
    ffmpeg -y -loglevel error -i file:"$file" -f ffmetadata -

# update metadata of a file passed from STDIN
[private]
update-metadata file:
    #!/usr/bin/env -S bash -Eeuo pipefail
    filename=$(basename "$file")
    dir=$(dirname "$file")
    tmpname="$dir/temp-$filename"
    trap 'rm -f -- "$tmpname"' EXIT
    args=(
        -y -loglevel warning
        # -vn -sn -dn
        -codec copy
        -map "0:a" -map "0:v?"
        -map_metadata 1 -map_chapters 1
        -movflags +faststart
    )
    umask 002
    ffmpeg -i "$file" -i /dev/stdin "${args[@]}" "$tmpname" \
        && mv -f -- "$tmpname" "$file"

[no-exit-message]
embed-thumbnail-mp4 path_audio path_png:
    #!/usr/bin/env -S python3

    from mutagen.mp4 import MP4, MP4Cover

    audio = MP4("{{path_audio}}")

    with open("{{path_png}}", "rb") as png:
        audio["covr"] = [MP4Cover(png.read(), imageformat=MP4Cover.FORMAT_PNG)]

    audio.save()

[no-exit-message]
embed-thumbnail-flac path_audio path_png:
    #!/usr/bin/env -S python3

    from mutagen import File
    from mutagen.flac import Picture, FLAC

    audio = File("{{path_audio}}")

    image = Picture()
    image.type = 3
    albumart="{{path_png}}"
    if albumart.endswith('png'):
        mime = 'image/png'
    else:
        mime = 'image/jpeg'
    image.desc = 'cover'

    with open(albumart, 'rb') as f:
        image.data = f.read()

    audio.add_picture(image)
    audio.save()


[no-exit-message]
list-art:
    #!/usr/bin/env perl
    use v5.42;
    my @files = grep { /\.(jpe?g|png)$/i && -f } glob("{.,./**}/*");
    my @sorted = sort { ($a =~ tr#/#/# <=> $b =~ tr#/#/#) || ($a cmp $b) } @files;

    say $_ foreach @sorted;

