#!/usr/bin/env -S bash -Eeuo pipefail

# @meta combine-shorts
# @meta require-tools base64,systemd-creds,setsid
# @meta version 1.0.0

# @describe ABSTRACT:
#   Git credential helper with persistent, host-bound encrypted storage via systemd-creds
#
# SYNOPSIS:
#   git-credential-systemd-creds store <<< $'protocol=https\nhost=gitlab.com\npassword=secret'
#   git-credential-systemd-creds get   <<< $'protocol=https\nhost=gitlab.com'
#   git-credential-systemd-creds erase <<< $'protocol=https\nhost=gitlab.com'
#
# DESCRIPTION:
#   Stores the full git credential blob, including oauth_refresh_token, encrypted with `systemd-creds --user`. The
#   ciphertext is bound to this machine and user, so it cannot be copied to another host. No GPG, pass, or socket
#   forwarding is involved.
#
#   The full blob is returned on get. When password_expiry_utc is in the past, Git clears the password but keeps
#   oauth_refresh_token, then continues to git-credential-oauth, which requests a fresh access token.
#
#   Files live under ${XDG_STATE_HOME}/git-credential-systemd-creds/ as <protocol>/<host>/<username>.systemd-cred.
#
#   Erase removes the stored blob, or all usernames for the host when no username is specified.

[[ -x "$(command -v argc)" ]] || {
    echo "'argc' helper command is required, install from https://github.com/sigoden/argc" >&2
    exit 2
}

umask 077

readonly STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/git-credential-systemd-creds"

function _assert_subdir() {
    local subdir
    subdir=$(realpath -m --relative-base="$STATE_DIR" -- "$1")
    if [[ "$subdir" == /* ]]; then
        echo "git-credential-systemd-creds: path is outside storage directory: $1" >&2
        exit 1
    fi
    echo "$subdir"
}

function _storage_path() {
    local subdir
    subdir=$(_assert_subdir "$STATE_DIR/$1")
    echo "$STATE_DIR/$subdir"
}

function _credential_path() {
    local protocol="$1" host="$2" username="$3"

    _storage_path "$protocol/$host/$username.systemd-cred"
}

function _read_stdin() {
    input="$(</dev/stdin)"

    while read -r line; do
        [[ "$line" =~ ^[_[:lower:]][_[:lower:][:digit:]]*= ]] && declare -g -- "$line"
    done <<< "$input"

    if [[ -z "${protocol:-}" || -z "${host:-}" ]]; then
        echo "continue=1"
        exit 0
    fi

    requested_username="${username:-}"

    if [[ -z "${username:-}" ]]; then
        username="${USER:-$(id -un)}"
        input+=$'\nusername='"$username"
    fi
}

# @cmd
# @describe
# Retrieve credentials from systemd-creds
function get() {
    _read_stdin

    local candidate credentials path
    local candidates=("$username")

    [[ "$username" != "${USER:-$(id -un)}" ]] && candidates+=("${USER:-$(id -un)}")
    [[ "$username" != "oauth2" ]] && candidates+=("oauth2")

    for candidate in "${candidates[@]}"; do
        path=$(_credential_path "$protocol" "$host" "$candidate")
        [[ -f "$path" ]] || continue

        if credentials="$(systemd-creds --user --no-ask-password decrypt "$path" 2>/dev/null)"; then
            echo "$credentials"
            exit 0
        fi

        echo "git-credential-systemd-creds: failed to decrypt $path, ignoring" >&2
    done

    echo "continue=1"
}

# @cmd
# @describe
# Store credentials in systemd-creds
function store() {
    _read_stdin

    local path dir
    path=$(_credential_path "$protocol" "$host" "$username")
    dir=$(dirname -- "$path")

    mkdir -p -- "$dir"
    chmod 700 -- "$dir"

    # NOTE: encryption is scrypt-bound (roughly 0.3-1s) and git does not read the result of `store`, so detach it.
    setsid -f bash -Eeuo pipefail -s -- "$path" >/dev/null 2>&1 <<EO_STORE
    path=\$1

    tmpfile="\${path}.new"

    trap 'rm -f -- "\$tmpfile"' EXIT
    base64 -d <<< "$(base64 -w0 <<< "$input")" \
        | systemd-creds --user --no-ask-password --name="\$(basename -- "\$path")" encrypt - "\$tmpfile"
    chmod 600 "\$tmpfile"
    mv -f -- "\$tmpfile" "\$path"
EO_STORE
}

# @cmd
# @describe
# Erase credentials from systemd-creds
function erase() {
    _read_stdin

    local path host_dir
    host_dir=$(_storage_path "$protocol/$host")

    if [[ -n "${requested_username:-}" ]]; then
        path=$(_credential_path "$protocol" "$host" "$requested_username")
        rm -f -- "$path"
        rmdir -- "$(dirname -- "$path")" 2>/dev/null || true
    else
        rm -rf -- "$host_dir"
    fi

    rmdir -- "$host_dir" 2>/dev/null || true
    rmdir -- "$(dirname -- "$host_dir")" 2>/dev/null || true
}

eval "$(argc --argc-eval "$0" "$@")"
