#!/usr/bin/env -S just --one --justfile

# https://just.systems/man/en/

set export
set no-cd

export this := justfile()

[private]
@default:
    "$this" --list

[positional-arguments]
build *argv:
    #!/usr/bin/env -S bash -Eeuo pipefail

    unset TMPDIR

    dir="$(dirname "$1")"
    name="$(basename "$1")"
    root="$(git -C "$dir" rev-parse --show-superproject-working-tree --show-toplevel | head -1)"

    image_name="$(echo -n "${name%%.*}" | perl -nE 'print lc')"
    image_path="registry.gitlab.com/andrew-grechkin/dotfiles/$image_name"
    tag="${2:+:$2}"

    # building 2 versions of image
    # 1. raw image with all layers preserved to have a cached rebuilds
    # 2. squashed and trimmed image to use in all runs

    args=(
        --rm
        --build-arg invalidate_cache_here="$(date --rfc-3339=seconds)"
        # --platform="linux/amd64,linux/arm64"
        # --manifest
        -t
    )

    docker build "${args[@]}" "${image_path}-raw${tag}" -f "$1" "$root"
    echo
    set -x
    docker build "${args[@]}" "${image_path}${tag}" --squash-all -f <(echo FROM "${image_path}-raw${tag}") "$root"

[positional-arguments]
run *argv:
    #!/usr/bin/env -S bash -Eeuo pipefail

    mapfile -t ports < <(docker image inspect "${@: -1}" --format '{{{{range $port, $_ := .Config.ExposedPorts}}{{{{$port}} {{{{end}}')

    for port_proto in "${ports[@]}"; do
        port=${port_proto%/*}
        args+=(-p "$port:$port")
    done

    docker run -it --rm "${args[@]}" "$@"
