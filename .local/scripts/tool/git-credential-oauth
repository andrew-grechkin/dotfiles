#!/usr/bin/env -S bash -Eeuo pipefail

# ABSTRACT:
#   Git credential helper wrapper around git-credential-oauth.
#
# DESCRIPTION:
#   Intentionally has the same name, because it's just a wrapper to detect environment it is executed in.
#
#   On a remote SSH session the browser authorization-code flow cannot complete: it needs a local browser and a callback
#   on the remote 127.0.0.1.
#
#   Use the OAuth device flow instead, which prints a code to enter on any other device.

# NOTE: modify PATH to prevent self execution
PATH="${PATH}:"; PATH=${PATH//"$(dirname -- "${BASH_SOURCE[0]}"):"/}; PATH=${PATH%:}

if [[ -n "${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-}" ]]; then
    exec git-credential-oauth -device "$@"
fi

exec git-credential-oauth "$@"
