#!/usr/bin/env -S just --one --justfile

set export
set no-cd

export this := justfile()

[private]
@default:
    "$this" --list

[positional-arguments]
diff lhs rhs:
    #!/usr/bin/env -S bash -Eeuo pipefail

    if [[ ! -d "$lhs" || ! -d "$rhs" ]]; then
        echo "Usage: $0 <dir1> <dir2>"
        exit 1
    fi

    lhs="${lhs%%/}"
    rhs="${rhs%%/}"

    tmp1=$(mktemp)
    tmp2=$(mktemp)
    trap 'rm -f "$tmp1" "$tmp2"' EXIT

    # Generate sorted TSV manifest: <hash>\t<relative_path>
    (cd "$lhs" && fd -t f -H -E .git -X b3sum | sed 's|^\([a-f0-9]\{64\}\)  \./\(.*\)|\1\t\2|') > "$tmp1"
    (cd "$rhs" && fd -t f -H -E .git -X b3sum | sed 's|^\([a-f0-9]\{64\}\)  \./\(.*\)|\1\t\2|') > "$tmp2"

    # TODO: fix
    D1="$lhs" D2="$rhs" perl -F'\t' -lane '
        $h{$F[1]}[$ARGVno] = $F[0];
        END {
            my ($d1, $d2) = ($ENV{D1}, $ENV{D2});
            for my $p (sort keys %h) {
                my ($v1, $v2) = @{$h{$p}};
                print "L\t$d1/$p"         if  $v1 && !$v2;
                print "R\t$d2/$p"         if !$v1 &&  $v2;
                print "X\t$d1/$p\t$d2/$p" if  $v1 &&  $v2 && $v1 ne $v2;
            }
        }
    ' "$tmp1" "$tmp2"

# zero drive and scan for badblocks
zero-and-scan drive:
    #!/usr/bin/env -S bash -Eeuo pipefail

    if [[ ! -b "$drive" ]]; then
        echo "fatal: device '$drive' does not exist or is not a block device" >&2
        exit 1
    fi

    cat << EO_WARNING >&2
    {{style("warning")}} =====================================================
    WARNING: DESTRUCTIVE WRITE OPERATION AHEAD
    =====================================================

    You are about to run a destructive badblocks scan on: $drive
    ALL DATA ON THIS DRIVE WILL BE PERMANENTLY ERASED AND ZEROED OUT{{NORMAL}}
    EO_WARNING

    read -rp "Type 'YES' to confirm and proceed: " confirm
    if [[ "$confirm" != "YES" ]]; then
        echo "fatal: operation aborted by user"
        exit 1
    fi

    sudo -k badblocks -wsv -b 4096 -t 0x00 -o "/var/log/badblocks.log" "$drive"

