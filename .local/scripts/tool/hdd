    chown -R root:root           "$mnt_dir/${prefix}$name"

    echo "> subvolumes:" >&2
    btrfs subvolume list         "$mnt_dir"

# backup all subdirs which have config
[positional-arguments]
backup dir='./':
    #!/usr/bin/env -S bash -Eeuo pipefail

    if [[ "$EUID" -ne 0 ]]; then
        echo "> elevating privileges..."
        exec sudo "$0" "$@"
    fi

    while read -r line; do
        "{{justfile()}}" _backup "$line"
    done < <(find "$1" -maxdepth 2 -type f -name backup.json)

# receive and extract btrfs image
[arg('image', pattern='(.*[.]btrfs[.]img[.]zstd)|(-)$'), positional-arguments]
receive-image image dest='./':
    #!/usr/bin/env -S bash -Eeuo pipefail

    if [[ "$EUID" -ne 0 ]]; then
        echo "> elevating privileges..."
        exec sudo "$0" "$@"
    fi
    echo "> receive: $1 -> $2" >&2

    filename="$(basename "$1")"
    dir="${filename%%.btrfs.img.zstd}"
    dest="${2%%/}/$dir"
    mkdir -p -- "$dest"
    chmod g+rwXs,o+rX -- "$dest"
    zstdcat "$1" | pv -Wbat | btrfs receive "$dest/"

[private, no-exit-message]
_backup-source pth:
    #!/usr/bin/env -S bash -Eeuo pipefail
    echo "> backup source: $pth" >&2
    descriptor=$(</dev/stdin)

    {
        read -r target_path
        read -r target_type
        read -r type
    } < <(jq -r '[.target.path, .target.type, .type]|map(.//"")[]' <<< "$descriptor")

    if [[ "$type" == "snapper-btrfs-send" ]]; then
        {
            read -r volume
        } < <(jq -r '[.volume]|map(.//"")[]' <<< "$descriptor")
        [[ -n "$volume" ]] || volume=$(basename "$pth")
        echo "> volume: {{YELLOW}}$volume{{NORMAL}}" >&2

        if info=$(snapper -c "$volume" --jsonout ls 2>/dev/null); then
            history=$(jq -Sc --arg volume "$volume" <<< "$info" '
                .[$volume] | sort_by(.date) | reverse | map(
                    select(
                        .active == false
                        and .default == false
                        and .date != ""
                        and .type == "single"
                        and .cleanup == "number"
                        and has("userdata")
                        and (.userdata | has("important"))
                        and (.userdata.important == "yes")
                    )
                )'
            )
            amount=$(jq -r 'length' <<< "$history")

            if (( amount == 0 )); then
                snapper -c "$volume" create -c "number" -d "backup" -u important="yes"
                echo "> initial snapshot created for: $volume" >&2
                exit 0
            fi

            dest="$target_path"
            if [[ "$(basename "$target_path")" != ".snapshots" ]]; then
                dest+="/$volume"
            fi

            for i in $(seq 0 1 $(( amount - 1 ))); do
                it=$(jq -r ".[$i]" <<< "$history")
                {
                    read -r number
                    read -r id
                    read -r subvolume
                } < <(jq -r '[.number, .userdata.id, .subvolume]|map(.//"")[]' <<< "$it")
                subvolume="${subvolume%/}"

                if [[ "$target_type" == "image" && -s "$dest/$id.btrfs.img.zstd" ]]; then
                    parent=(-p "$subvolume/.snapshots/$number/snapshot")
                    break
                fi

                if [[ "$target_type" == "snapshot" && -d "$dest/$id/snapshot" ]]; then
                    parent=(-p "$subvolume/.snapshots/$number/snapshot")
                    break
                fi
            done

            target_id=$(date --universal --rfc-3339=seconds)
            if new_id=$(snapper -c "$volume" create -p -c "number"); then
                snapshot="$subvolume/.snapshots/$new_id/snapshot"
                mkdir -p -- "$dest"
                chmod g+rwXs,o+rX -- "$dest"
                name="$dest/$target_id.btrfs.img.zstd"

                if [[ "$target_type" == "image" ]]; then
                    trap 'rm -f -- "$name.tmp"' EXIT
                    umask 0007
                    btrfs send "${parent[@]}" "$snapshot" | zstd -o "$name.tmp"
                    mv -- "$name.tmp" "$name"
                elif [[ "$target_type" == "snapshot" ]]; then
                    mkdir -p -- "$dest/$target_id"
                    chmod g+rwXs,o+rX -- "$dest/$target_id"
                    btrfs send "${parent[@]}" "$snapshot" | pv -Wbat \
                        | btrfs receive "$dest/$target_id/"
                fi
                snapper -c "$volume" modify -d "backup,$target_type" -u "important=yes,id=$target_id" "$new_id"
                exit 0
            fi
            "$this" fatal "couldn't backup volume"
        fi
    fi
    "$this" fatal "unknown type"

[private, no-exit-message]
_backup config:
    #!/usr/bin/env -S bash -Eeuo pipefail
    src=$(realpath -e "$(dirname "$config")")
    while read -r line; do
        "$this" _backup-source "$src" <<< "$line"
    done < <(jq -c '.targets[]?' -- "$config")

[group('helper'), private, positional-arguments, no-exit-message]
@fatal message_or_errno *argv:
    #!/usr/bin/env -S bash -Eeuo pipefail
    [[ "$message_or_errno" =~ ^[0-9]+$ && "$message_or_errno" -g 0 && "$message_or_errno" -le 255 ]] && {
        errno="$message_or_errno"
        shift 1
    }
    echo "{{style('error')}}> fatal:" "$@" "{{NORMAL}}" >&2
    exit "${errno:-1}"
