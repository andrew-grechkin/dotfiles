# vim: filetype=toml

# https://mise.jdx.dev/configuration/settings.html

[settings]
activate_aggressive = false
auto_install = false
disable_tools = ["yarn"]
gpg_verify = false
jobs = 3

[tools]
argc = "latest"
delta = "latest"
eza = "latest"
fzf = "latest"
go = "latest"
jaq = "latest"
jq = "latest"
neovim = "latest"
rg = "latest"
tree-sitter = "latest"
usage = "latest"
# "aqua:hickford/git-credential-oauth" = "latest"
"go:github.com/andrew-grechkin/colored-md" = "latest"
"go:github.com/andrew-grechkin/git-credential-oauth" = "latest"
"go:github.com/andrew-grechkin/gotmpl2text" = "latest"

[tools.bat]
postinstall = '''
    exec >&2
    umask 022
    mkdir -p $XDG_DATA_HOME/completion $XDG_DATA_HOME/man/man1
    ln -fs $MISE_TOOL_INSTALL_PATH/**/autocomplete/bat.zsh $XDG_DATA_HOME/completion/_bat
    ln -fs $MISE_TOOL_INSTALL_PATH/**/*.1 $XDG_DATA_HOME/man/man1
'''
version = "latest"

[tools.fd]
postinstall = '''
    exec >&2
    umask 022
    mkdir -p $XDG_DATA_HOME/completion $XDG_DATA_HOME/man/man1
    ln -fs $MISE_TOOL_INSTALL_PATH/**/autocomplete/_* $XDG_DATA_HOME/completion
    ln -fs $MISE_TOOL_INSTALL_PATH/**/*.1 $XDG_DATA_HOME/man/man1
'''
version = "latest"

[tools.gum]
postinstall = '''
    exec >&2
    umask 022
    mkdir -p $XDG_DATA_HOME/completion $XDG_DATA_HOME/man/man1
    ln -fs $MISE_TOOL_INSTALL_PATH/**/completions/gum.zsh $XDG_DATA_HOME/completion/_gum
    ln -fs $MISE_TOOL_INSTALL_PATH/**/manpages/*.1.gz $XDG_DATA_HOME/man/man1
'''
version = "latest"

[tools.just]
postinstall = '''
    exec >&2
    umask 022
    mkdir -p $XDG_DATA_HOME/completion $XDG_DATA_HOME/man/man1
    # OMG: disabling standard completion for just because it's an utter garbage
    # all flags, subcommands, files are scrumbled together
    # will use my own override for now in `.config/zsh/lib/97-completions`
    # ln -fs $MISE_TOOL_INSTALL_PATH/**/completions/just.zsh $XDG_DATA_HOME/completion/_just
    ln -fs $MISE_TOOL_INSTALL_PATH/**/*.1 $XDG_DATA_HOME/man/man1
'''
version = "latest"

[tools.node]
postinstall = '''
    exec >&2
    umask 022
    echo "> installing global NPM modules"
    npm install -g neovim pnpm yarn
'''
version = "24.16.0"

[tools.xh]
postinstall = '''
    exec >&2
    umask 022
    mkdir -p $XDG_DATA_HOME/completion $XDG_DATA_HOME/man/man1
    ln -fs $MISE_TOOL_INSTALL_PATH/**/completions/_xh $XDG_DATA_HOME/completion/
    ln -fs $MISE_TOOL_INSTALL_PATH/**/doc/*.1 $XDG_DATA_HOME/man/man1
'''
version = "latest"
