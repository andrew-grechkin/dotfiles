# vim: filetype=sh foldmethod=marker

# shellcheck disable=SC2034,SC2028

# => environment -------------------------------------------------------------------------------------------------- {{{1

export HOSTNAME="${HOSTNAME:-${HOST:-$(hostname)}}"

# => PATH --------------------------------------------------------------------------------------------------------- {{{1

function append_path () {
    [[ -d "$1" ]] || return
    case ":$PATH:" in
        *:"$1":*) ;;
        *) PATH="${PATH:+$PATH:}$1" ;;
    esac
}

function prepend_path () {
    [[ -d "$1" ]] || return
    case ":$PATH:" in
        *:"$1":*) ;;
        *) PATH="$1${PATH:+:$PATH}" ;;
    esac
}

function _setup_path() {
    local append_dirs=(
        "$HOME/.cache/bin"
        "$GOPATH/bin"
        "/usr/lib/qt6/bin"
    )

    local dir p
    for p in "${append_dirs[@]}"; do append_path "$p"; done
    export PATH

    local prepend_dirs=(
        "$XDG_CACHE_HOME/nvim/mason/bin"
        "$XDG_DATA_HOME/nvim/mason/bin"
        "$HOME/.local/bin"
        "$HOME/.local/usr/bin"
        "$HOME/.local/script"
        "$HOME/.local/scripts-ext/work-public"
        "$HOME/.local/scripts-ext/work-private"
        "$HOME/.local/scripts-ext/private"
    )

    for dir in "$HOME/.local/scripts"/*; do
        prepend_dirs+=("$dir")
    done

    for p in "${prepend_dirs[@]}"; do
        prepend_path "$p"
    done

    export PATH
}

_setup_path
unset -f _setup_path
