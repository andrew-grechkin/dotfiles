[Unit]
Description=Home-row modifiers and hotkey executor
After=graphical-session.target
StartLimitIntervalSec=30
StartLimitBurst=10

[Service]
Type=simple
ExecStart=%h/.local/scripts/input/keymapd
ExecReload=/usr/bin/kill -USR1 $MAINPID
Restart=on-failure
RestartSec=1
KillMode=process

[Install]
WantedBy=graphical-session.target
